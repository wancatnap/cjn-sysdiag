<Window x:Class="SysDiag.SystemTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统调优" Height="720" Width="900" MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <TextBlock Text="系统调优" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
            <TextBlock Text="四项都属于系统层设置，改的是注册表里的开关。每项都会先备份原值，「还原全部改动」可以一键回去。"
                       FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 管理员提示 -->
        <Border x:Name="AdminBanner" Background="#FFF5F5" BorderBrush="#FFC9C9" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12" FontWeight="SemiBold"
                           Foreground="#C92A2A" />
                <TextBlock x:Name="AdminDetail"
                           Text="GPU 调度、系统服务、CPU 调度都写在 HKLM，普通权限改不了。点右下角「以管理员身份重启」，重启后会自动回到本窗口。关闭 Game Bar 只写 HKCU，不需要管理员。"
                           FontSize="10.5" Foreground="#868E96" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="24,12,24,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,4,8">
            <StackPanel x:Name="ItemHost" />

            <!-- CPU 档位 -->
            <Border x:Name="CpuBox" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU 前后台调度" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#212529" VerticalAlignment="Center" />
                            <Border x:Name="CpuBadge" Background="#E7F5FF" CornerRadius="7" Padding="7,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CpuBadgeText" Text="前台调度" FontSize="10" Foreground="#1971C2" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="CpuDesc" FontSize="11" Foreground="#495057" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="CpuDetail" FontSize="10.5" Foreground="#868E96" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <Border x:Name="CpuWarn" Background="#FFF9DB" BorderBrush="#FFE066" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" Margin="0,8,0,0">
                            <TextBlock x:Name="CpuWarnText" FontSize="10.5" Foreground="#8A6D00"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Width="230">
                        <TextBlock Text="调度档位" FontSize="10" Foreground="#868E96" HorizontalAlignment="Right" />
                        <ComboBox x:Name="CpuCombo" Margin="0,5,0,0" Height="28" FontSize="11.5"
                                  DisplayMemberPath="Name" />
                        <Button x:Name="CpuApplyBtn" Content="应用档位" Style="{StaticResource ToolButton}"
                                Margin="0,7,0,0" HorizontalAlignment="Right" Click="OnApplyCpu" />
                    </StackPanel>
                </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#868E96" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="400" HorizontalAlignment="Left"
                           Text="四项都可以单独开关，互不影响。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                    <Button Content="还原全部改动" Style="{StaticResource ToolButton}" Click="OnRestoreAll" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
