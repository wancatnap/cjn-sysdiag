<Window x:Class="SysDiag.LiveOptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="直播伴侣优化" Height="580" Width="840" MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,12">
            <TextBlock Text="直播伴侣优化" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
            <TextBlock Text="降低直播伴侣优先级、把它限制到非 0 号核心、切换到高性能电源计划。全部动作都可以用「还原」回退。"
                       FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 指标 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="24,0,24,0">
            <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CPU 总占用" FontSize="11" Foreground="#868E96" />
                    <TextBlock x:Name="CpuValue" Text="--" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1F2937" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="内存占用" FontSize="11" Foreground="#868E96" />
                    <TextBlock x:Name="MemValue" Text="--" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1F2937" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CPU 温度" FontSize="11" Foreground="#868E96" />
                    <TextBlock x:Name="TempValue" Text="--" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1F2937" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="10"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="直播伴侣" FontSize="11" Foreground="#868E96" />
                    <TextBlock x:Name="ProcValue" Text="--" FontSize="15" FontWeight="SemiBold"
                               Foreground="#495057" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 结果 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1"
                CornerRadius="10" Margin="24,12,24,0" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="优化记录" FontSize="12" FontWeight="SemiBold"
                           Foreground="#495057" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Text="等待操作…" FontSize="11.5"
                               FontFamily="Consolas" Foreground="#495057"
                               TextWrapping="Wrap" LineHeight="19" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Text="每 2 秒刷新一次" FontSize="11"
                           Foreground="#868E96" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Click="OnRefresh" />
                    <Button Content="还原" Style="{StaticResource ToolButton}" Click="OnRestore" />
                    <Button Content="优化直播伴侣" Style="{StaticResource PrimaryButton}" Click="OnOptimize" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
