<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- =========================================================
         科幻风主题 · Dark HUD
         深空底 + 青色霓虹 + 细网格 + 硬朗小圆角
         原则：炫但能读 —— 发光只用在标题与悬停态，正文保持高对比
         ========================================================= -->

    <!-- 表面与描边 -->
    <SolidColorBrush x:Key="Canvas"        Color="#070A10" />
    <SolidColorBrush x:Key="CanvasDeep"    Color="#04070C" />
    <SolidColorBrush x:Key="Surface"       Color="#0E1420" />
    <SolidColorBrush x:Key="SurfaceHover"  Color="#121C2E" />
    <SolidColorBrush x:Key="SurfaceRaise"  Color="#161F33" />
    <SolidColorBrush x:Key="Line"          Color="#1B2740" />
    <SolidColorBrush x:Key="LineBright"    Color="#2A3D5C" />
    <SolidColorBrush x:Key="LineSoft"      Color="#131C2C" />

    <!-- 文字：冷白 → 钢灰 -->
    <SolidColorBrush x:Key="Ink"           Color="#E8F0FA" />
    <SolidColorBrush x:Key="InkSecondary"  Color="#A9B9CF" />
    <SolidColorBrush x:Key="InkTertiary"   Color="#8698B4" />
    <SolidColorBrush x:Key="InkFaint"      Color="#63758F" />

    <!-- 主色：青色霓虹 -->
    <SolidColorBrush x:Key="Primary"       Color="#22D3EE" />
    <SolidColorBrush x:Key="PrimarySoft"   Color="#0C2A33" />
    <SolidColorBrush x:Key="PrimaryLine"   Color="#1C5C74" />
    <SolidColorBrush x:Key="PrimaryPress"  Color="#67E8F9" />
    <SolidColorBrush x:Key="PrimaryDim"    Color="#7DD3E0" />

    <!-- 次色：电紫 -->
    <SolidColorBrush x:Key="Accent"        Color="#8B5CF6" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#191032" />

    <!-- 语义 -->
    <SolidColorBrush x:Key="Success"       Color="#34D399" />
    <SolidColorBrush x:Key="SuccessSoft"   Color="#062A22" />
    <SolidColorBrush x:Key="Warn"          Color="#FBBF24" />
    <SolidColorBrush x:Key="WarnSoft"      Color="#2A1E05" />
    <SolidColorBrush x:Key="Danger"        Color="#FB7185" />
    <SolidColorBrush x:Key="DangerSoft"    Color="#2A0D14" />

    <!-- 间距 -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <!-- 圆角：科幻偏硬朗 -->
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <CornerRadius x:Key="RadiusButton">6</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- =========================================================
         背景网格：32px 一格，极暗，只提供质感
         ========================================================= -->
    <DrawingBrush x:Key="GridBg" TileMode="Tile"
                  Viewport="0,0,32,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,32" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#0A1120" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                            <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#111C2E" Thickness="0.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 顶部氛围光 -->
    <RadialGradientBrush x:Key="TopGlow" GradientOrigin="0.5,-0.2" Center="0.5,-0.2"
                         RadiusX="0.9" RadiusY="0.8">
        <GradientStop Color="#0B1A24" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <!-- =========================================================
         功能卡片：暗面板 + 青边 + 左上角 L 形刻度 + 悬停发光
         ========================================================= -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Width" Value="196" />
        <Setter Property="Height" Value="92" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>

                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1" />

                        <!-- 左上角刻度（HUD 装饰） -->
                        <Path x:Name="Corner" Data="M 1,11 L 1,1 L 11,1"
                              Stroke="{StaticResource LineBright}" StrokeThickness="1.2"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />

                        <!-- 右侧竖向能量条（仅在悬停时亮起） -->
                        <Border x:Name="Beam" Width="2" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Height="26" CornerRadius="1"
                                Background="#00000000" />

                        <ContentPresenter Margin="15,14,12,12"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                            <Setter TargetName="Corner" Property="Stroke" Value="{StaticResource Primary}" />
                            <Setter TargetName="Beam" Property="Background" Value="{StaticResource Primary}" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#22D3EE" BlurRadius="16"
                                                      ShadowDepth="0" Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryPress}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         工具栏按钮：暗底 + 细边
         ========================================================= -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondary}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryDim}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮：青底深字 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="#04141A" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPress}" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#22D3EE" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纯文字按钮 -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkTertiary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5" Background="#00000000"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaise}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         搜索框
         ========================================================= -->
    <Style x:Key="SearchInput" TargetType="TextBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBright}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#22D3EE" BlurRadius="12"
                                                      ShadowDepth="0" Opacity="0.3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         细滚动条（暗色）
         ========================================================= -->
    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="#243249" Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource PrimaryLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
