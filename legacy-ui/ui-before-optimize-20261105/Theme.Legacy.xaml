<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         旧版主题（界面优化前的样式，原样保留）
         用途：带 legacy-theme 参数启动时加载，用于对照与回退
         注意：下面第一段 token 只是为了让新版 MainWindow.xaml 能解析，
               色彩取旧版的值；真正的界面回退请用 legacy-ui/ 里的文件覆盖。
         ========================================================= -->

    <SolidColorBrush x:Key="Ink"          Color="#1F2937" />
    <SolidColorBrush x:Key="InkSecondary" Color="#495057" />
    <SolidColorBrush x:Key="InkTertiary"  Color="#868E96" />
    <SolidColorBrush x:Key="InkFaint"     Color="#ADB5BD" />
    <SolidColorBrush x:Key="Line"         Color="#E9ECEF" />
    <SolidColorBrush x:Key="LineSoft"     Color="#F1F3F5" />
    <SolidColorBrush x:Key="Surface"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Canvas"       Color="#F6F7F9" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F8F9FA" />

    <SolidColorBrush x:Key="Primary"      Color="#4C6EF5" />
    <SolidColorBrush x:Key="PrimarySoft"  Color="#EDF2FF" />
    <SolidColorBrush x:Key="PrimaryLine"  Color="#CED4DA" />
    <SolidColorBrush x:Key="PrimaryPress" Color="#3B5BDB" />

    <SolidColorBrush x:Key="Success"     Color="#2F9E44" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#EBFBEE" />
    <SolidColorBrush x:Key="Warn"        Color="#B08900" />
    <SolidColorBrush x:Key="WarnSoft"    Color="#FFF9DB" />
    <SolidColorBrush x:Key="Danger"      Color="#C92A2A" />
    <SolidColorBrush x:Key="DangerSoft"  Color="#FFF5F5" />

    <!-- =========================================================
         以下是优化前的原始样式，一行未改
         ========================================================= -->

    <!-- 卡片按钮：白底圆角 + 悬停变化 -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="86" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="10"
                            Background="#FFFFFF"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1">
                        <ContentPresenter Margin="12,11,10,11"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F8F9FA" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#CED4DA" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F3F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏按钮 -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#495057" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#DEE2E6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F3F5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="#4C6EF5" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#4C6EF5" />
    </Style>

    <!-- 新版布局用到、旧版没有的样式：给等价定义，保证带 legacy-theme 参数时能起来 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style x:Key="SearchInput" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#DEE2E6" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
