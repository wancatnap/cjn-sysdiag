<Window x:Class="SysDiag.NetRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="断网急救" Height="760" Width="920" MinHeight="620" MinWidth="800"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 体检项 -->
        <DataTemplate x:Key="CheckTemplate">
            <Border Padding="11,8" Margin="0,0,0,6" Background="#FFFFFF"
                    BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding LevelBg}" CornerRadius="6" Padding="7,2"
                            MinWidth="42" Margin="0,1,10,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding LevelText}" FontSize="10" Foreground="{Binding LevelColor}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#212529" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#868E96"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FixHint}" FontSize="10" Foreground="#B08900"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasFixHint, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 修复步骤 -->
        <DataTemplate x:Key="StepTemplate">
            <Border Padding="11,8" Margin="0,0,0,6" Background="#FFFFFF"
                    BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                              VerticalAlignment="Top" Margin="0,2,10,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#212529" />
                            <Border Background="#FFF9DB" BorderBrush="#FFE066" BorderThickness="1"
                                    CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="需重启" FontSize="9.5" Foreground="#B08900" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Effect}" FontSize="10.5" Foreground="#868E96"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding Command}" FontSize="9.5" Foreground="#ADB5BD"
                               FontFamily="Consolas" VerticalAlignment="Center" MaxWidth="230"
                               TextWrapping="Wrap" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="断网急救" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
            <TextBlock Text="先体检网络链路，再按勾选的步骤修复。只用 Windows 自带的 netsh / ipconfig，动手前自动备份 hosts 和代理设置。"
                       FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 管理员提示 -->
        <Border x:Name="AdminBanner" Background="#FFF5F5" BorderBrush="#FFC9C9" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="14,9">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12" FontWeight="SemiBold"
                           Foreground="#C92A2A" />
                <TextBlock x:Name="AdminDetail"
                           Text="修复动作要改 Winsock 目录、TCP/IP 配置和 hosts。点右下角「以管理员身份重启」，重启后会自动回到本窗口。体检不需要管理员。"
                           FontSize="10.5" Foreground="#868E96" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 体检 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,7">
                <TextBlock Text="链路体检" FontSize="12.5" FontWeight="SemiBold" Foreground="#343A40"
                           VerticalAlignment="Center" />
                <Button Content="重新体检" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                        Click="OnRecheck" />
                <TextBlock x:Name="CheckHint" FontSize="10.5" Foreground="#868E96"
                           VerticalAlignment="Center" Margin="12,0,0,0" Text="正在体检…" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="290">
                <ItemsControl x:Name="CheckList" ItemTemplate="{StaticResource CheckTemplate}" />
            </ScrollViewer>

            <!-- 修复步骤 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,14,0,7">
                <TextBlock Text="修复步骤" FontSize="12.5" FontWeight="SemiBold" Foreground="#343A40"
                           VerticalAlignment="Center" />
                <Button Content="全选" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                        Click="OnSelectAll" />
                <Button Content="全不选" Style="{StaticResource ToolButton}" Click="OnClearAll" />
                <TextBlock x:Name="StepHint" FontSize="10.5" Foreground="#868E96"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="230">
                <ItemsControl x:Name="StepList" ItemTemplate="{StaticResource StepTemplate}" />
            </ScrollViewer>
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#868E96" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left"
                           Text="勾选要执行的步骤，然后点「开始修复」。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="FixBtn" Content="开始修复" Style="{StaticResource PrimaryButton}"
                            Click="OnFix" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
