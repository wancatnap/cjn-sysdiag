<Window x:Class="SysDiag.DnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS 优化" Height="720" Width="880" MinHeight="580" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 网卡行 -->
        <DataTemplate x:Key="AdapterTemplate">
            <Border Padding="11,8" Margin="0,0,0,6" Background="#FFFFFF"
                    BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#212529" />
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#868E96"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#F1F3F5" CornerRadius="7" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeText}" FontSize="10" Foreground="#495057" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- DNS 方案行 -->
        <DataTemplate x:Key="PresetTemplate">
            <Border Padding="12,9" Margin="0,0,0,6" Background="#FFFFFF"
                    BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#212529" />
                            <Border Background="#EBFBEE" BorderBrush="#B2F2BB" BorderThickness="1" CornerRadius="7"
                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="推荐" FontSize="10" Foreground="#2F9E44" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding IpHint}" FontSize="10.5" Foreground="#495057"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Note}" FontSize="10" Foreground="#ADB5BD"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{Binding GradeBg}" CornerRadius="7" Padding="8,2"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LatencyText}" FontSize="10.5"
                                   Foreground="{Binding GradeColor}" FontWeight="SemiBold" />
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding TagText}" FontSize="10"
                               Foreground="#2F9E44" VerticalAlignment="Center" MinWidth="24" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <TextBlock Text="DNS 优化" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
            <TextBlock Text="并发测速多个公共 DNS，把最快的设到网卡上；随时能还原成自动获取或优化前的设置。"
                       FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 管理员提示 -->
        <Border x:Name="AdminBanner" Background="#FFF5F5" BorderBrush="#FFC9C9" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="14,9">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12" FontWeight="SemiBold"
                           Foreground="#C92A2A" />
                <TextBlock x:Name="AdminDetail"
                           Text="改 DNS 要写网卡配置。点右下角「以管理员身份重启」，重启后会自动回到本窗口。测速不需要管理员。"
                           FontSize="10.5" Foreground="#868E96" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 网卡 -->
        <StackPanel Grid.Row="2" Margin="24,12,24,0">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,7">
                <TextBlock Text="网卡" FontSize="12.5" FontWeight="SemiBold" Foreground="#343A40"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="AdapterHint" FontSize="10.5" Foreground="#868E96" Margin="10,0,0,0"
                           VerticalAlignment="Center" Text="勾选要应用 DNS 的网卡（可多选）" />
            </StackPanel>

            <ItemsControl x:Name="AdapterList" ItemTemplate="{StaticResource AdapterTemplate}" />
        </StackPanel>

        <!-- 方案 -->
        <Grid Grid.Row="3" Margin="24,10,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,7">
                <TextBlock Text="DNS 方案" FontSize="12.5" FontWeight="SemiBold" Foreground="#343A40"
                           VerticalAlignment="Center" />
                <Button Content="开始测速" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                        Click="OnProbe" />
                <Button Content="选中推荐" Style="{StaticResource ToolButton}" Click="OnPickBest" />
                <TextBlock x:Name="ProbeHint" FontSize="10.5" Foreground="#868E96"
                           VerticalAlignment="Center" Margin="12,0,0,0" Text="还没测速，延迟仅供参考"
                           TextTrimming="CharacterEllipsis" MaxWidth="300" />
            </StackPanel>

            <ListBox x:Name="PresetList" Grid.Row="1" ItemTemplate="{StaticResource PresetTemplate}"
                     BorderThickness="0" Background="Transparent" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#868E96" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="330" HorizontalAlignment="Left"
                           Text="先测速，再选方案应用到网卡。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                    <Button Content="恢复为自动获取" Style="{StaticResource ToolButton}" Click="OnRestoreDhcp" />
                    <Button Content="恢复到优化前" Style="{StaticResource ToolButton}" Click="OnRestoreBackup" />
                    <Button x:Name="ApplyBtn" Content="应用选中方案" Style="{StaticResource PrimaryButton}"
                            Click="OnApply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
