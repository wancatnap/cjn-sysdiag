<Window x:Class="SysDiag.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="报告查看器" Height="880" Width="1240" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="#F1F3F5"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                               Foreground="#212529" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="EnginePill" Background="#FFF0F6" CornerRadius="9" Padding="9,2"
                            Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EngineText" FontSize="11" Foreground="#D6336C" />
                    </Border>
                    <TextBlock x:Name="SubText" FontSize="11" Foreground="#868E96" Margin="12,1,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="重新加载" Style="{StaticResource ToolButton}" Click="OnReload" />
                    <Button Content="浏览器打开" Style="{StaticResource ToolButton}" Click="OnOpenBrowser" />
                    <Button x:Name="CopyBtn" Content="复制摘要" Style="{StaticResource ToolButton}"
                            Visibility="Collapsed" Click="OnCopySummary" />
                    <Button Content="打开所在目录" Style="{StaticResource ToolButton}" Click="OnOpenFolder" />
                    <Button Content="关闭" Style="{StaticResource PrimaryButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="White" />

            <Border x:Name="Loading" Background="#F8F9FA">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="正在准备内置浏览器…" FontSize="13" Foreground="#868E96"
                               HorizontalAlignment="Center" />
                    <ProgressBar Height="3" Width="180" Margin="0,14,0,0" IsIndeterminate="True"
                                 Foreground="#4C6EF5" Background="#E9ECEF" BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border x:Name="Fallback" Background="#FFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <TextBlock Text="内置浏览器不可用" FontSize="16" FontWeight="SemiBold"
                               Foreground="#212529" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FallbackMsg" FontSize="12" Foreground="#868E96" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="用系统浏览器打开这份报告" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" HorizontalAlignment="Center" Click="OnOpenBrowser" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
