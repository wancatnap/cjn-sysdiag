<Window x:Class="SysDiag.UsnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件删除记录" Height="560" Width="800" MinHeight="440" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,20,24,12">
            <StackPanel>
                <TextBlock Text="文件删除记录" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
                <TextBlock Text="读 NTFS 的 USN 变更日志，列出某段时间内被删除的文件。只读，不恢复、不改动任何数据。"
                           FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- 权限提示 -->
        <Border x:Name="AdminBanner" Background="#FFF5F5" BorderBrush="#FFC9C9" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#C92A2A" />
                <TextBlock x:Name="AdminDetail" Text="读取 USN 日志要打开磁盘卷句柄，普通权限拿不到。点下面的按钮会弹一次 UAC，以管理员身份重启整个程序；重启后自动回到这里并按当前选择开始读取。"
                           FontSize="11" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 参数 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1"
                CornerRadius="10" Margin="24,12,24,0" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="磁盘" FontSize="12" Foreground="#495057"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="DriveBox" Grid.Column="1" Width="90" Height="28" Margin="8,0,18,0"
                          VerticalContentAlignment="Center" />

                <TextBlock Grid.Column="2" Text="时间范围" FontSize="12" Foreground="#495057"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="RangeBox" Grid.Column="3" Width="130" Height="28" Margin="8,0,0,0"
                          VerticalContentAlignment="Center" SelectedIndex="1">
                    <ComboBoxItem Content="最近 24 小时" Tag="24" />
                    <ComboBoxItem Content="最近 7 天" Tag="168" />
                    <ComboBoxItem Content="最近 30 天" Tag="720" />
                    <ComboBoxItem Content="全部可用记录" Tag="0" />
                </ComboBox>

                <TextBlock Grid.Column="4" Text="USN 日志按容量滚动覆盖，通常只保留最近几天到几周"
                           FontSize="10.5" Foreground="#ADB5BD" VerticalAlignment="Center"
                           Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="" />

        <!-- 底部 -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#868E96" VerticalAlignment="Center"
                           Text="选择磁盘与时间范围，然后用右下角按钮开始读取。" TextTrimming="CharacterEllipsis" MaxWidth="430"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="ScanBtn" Content="开始读取" Style="{StaticResource PrimaryButton}"
                            Click="OnScan" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
