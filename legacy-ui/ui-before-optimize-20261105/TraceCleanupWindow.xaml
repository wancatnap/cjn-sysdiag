<Window x:Class="SysDiag.TraceCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="痕迹清理" Height="640" Width="880" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="TraceTemplate">
            <Border Padding="12,9" Margin="0,0,0,6" Background="#FFFFFF"
                    BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#212529" TextTrimming="CharacterEllipsis" />
                            <Border Background="#F1F3F5" CornerRadius="7" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Group}" FontSize="10" Foreground="#868E96" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#868E96"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#495057"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding AdminText}" FontSize="10" Foreground="#C92A2A"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <TextBlock Text="痕迹清理" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
            <TextBlock Text="逐项选择要删除的记录。文件走回收站，注册表项和事件日志删除后不可恢复；默认全部不勾选。"
                       FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="AdminBanner" Background="#FFF5F5" BorderBrush="#FFC9C9" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12" FontWeight="SemiBold"
                           Foreground="#C92A2A" />
                <TextBlock x:Name="AdminDetail"
                           Text="USB 记录在 HKLM、系统日志清空也需要管理员。点右下角「以管理员身份重启」，重启后会自动回到本窗口。"
                           FontSize="10.5" Foreground="#868E96" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="全选" Style="{StaticResource ToolButton}" Click="OnSelectAll" />
                <Button Content="全不选" Style="{StaticResource ToolButton}" Click="OnClearAll" />
                <Button Content="刷新" Style="{StaticResource ToolButton}" Click="OnRefresh" />
                <TextBlock x:Name="ScanHint" FontSize="11" Foreground="#868E96"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <ListBox x:Name="TraceList" Grid.Row="1" ItemTemplate="{StaticResource TraceTemplate}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Grid>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#868E96" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="DeleteBtn" Content="删除选中" Style="{StaticResource PrimaryButton}"
                            Click="OnDelete" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
