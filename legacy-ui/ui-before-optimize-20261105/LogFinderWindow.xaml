<Window x:Class="SysDiag.LogFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查找游戏日志" Height="640" Width="960" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="24,20,24,10">
            <StackPanel>
                <TextBlock Text="查找游戏日志" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
                <TextBlock Text="全盘搜索 Unreal 引擎游戏的日志目录（*\Saved\Logs），不依赖安装位置。找到后可自己勾选要分析的文件。"
                           FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="重新扫描" Style="{StaticResource ToolButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRescan" />
        </Grid>

        <!-- 结果 -->
        <Grid Grid.Row="1" Margin="24,0,16,0">
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="9" Background="#FFFFFF"
                                            BorderBrush="#E9ECEF" BorderThickness="1" Padding="14,11">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F8F9FA" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EDF2FF" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4C6EF5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Game}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#212529" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="#ADB5BD"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                        MinWidth="90">
                                <TextBlock Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#343A40" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="#868E96"
                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10.5"
                                       Foreground="#ADB5BD" VerticalAlignment="Center"
                                       Margin="16,0,0,0" MinWidth="110" TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Text="正在扫描…" FontSize="12" Foreground="#ADB5BD"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#868E96" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="打开所在目录" Style="{StaticResource ToolButton}" Click="OnOpenFolder" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="AnalyzeBtn" Content="分析整个目录" Style="{StaticResource ToolButton}"
                            IsEnabled="False" Click="OnAnalyze" />
                    <Button x:Name="PickBtn" Content="选择文件…" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="OnPick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
