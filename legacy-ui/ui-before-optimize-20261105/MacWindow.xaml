<Window x:Class="SysDiag.MacWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网卡 MAC" Height="620" Width="880" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="AdapterTemplate">
            <Border Padding="12,10" Margin="0,0,0,6" Background="#FFFFFF"
                    BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#212529" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#868E96"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HardwareText}" FontSize="11" Foreground="#495057" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding PermanentText}" FontSize="11" Foreground="#868E96" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OverrideLabel}" FontSize="11" Foreground="#C92A2A"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="#ADB5BD"
                                   HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,12">
            <TextBlock x:Name="TitleText" Text="修改网卡 MAC" FontSize="19" FontWeight="SemiBold" Foreground="#1F2937" />
            <TextBlock x:Name="SubText"
                       Text="通过注册表 NetworkAddress 修改网卡 MAC。写入后需要重启网卡或重启电脑才生效。"
                       FontSize="11.5" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 权限提示 -->
        <Border x:Name="AdminBanner" Background="#FFF5F5" BorderBrush="#FFC9C9" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#C92A2A" />
                <TextBlock x:Name="AdminDetail"
                           Text="修改网卡注册表需要管理员权限。点右下角「以管理员身份重启」，重启后会自动回到本窗口。"
                           FontSize="11" Foreground="#868E96" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 网卡列表 -->
        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="ListHint" Text="选择一块网卡" FontSize="11.5"
                       Foreground="#495057" Margin="2,0,0,8" />

            <ListBox x:Name="AdapterList" Grid.Row="1" ItemTemplate="{StaticResource AdapterTemplate}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnAdapterChanged" />

            <Border x:Name="InputPanel" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="新 MAC" FontSize="12" Foreground="#495057" VerticalAlignment="Center" />
                        <TextBox x:Name="MacBox" Width="220" Height="30" Margin="10,0,0,0"
                                 Padding="8,0" VerticalContentAlignment="Center" FontSize="12.5"
                                 FontFamily="Consolas" />
                        <Button x:Name="RandomBtn" Content="随机生成" Style="{StaticResource ToolButton}"
                                Margin="10,0,0,0" Click="OnRandom" />
                        <TextBlock Text="格式：12 位十六进制，可带 - 或 :" FontSize="10.5"
                                   Foreground="#ADB5BD" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="TipText"
                               Text="建议第一字节用 02（本地管理地址），避免和真实厂商前缀冲突。改完重启网卡生效。"
                               FontSize="10.5" Foreground="#ADB5BD" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 状态 -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="26,10,26,0" FontSize="11"
                   Foreground="#868E96" TextWrapping="Wrap" />

        <!-- 底部按钮 -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                        Click="OnElevate" Visibility="Collapsed" />
                <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                <Button x:Name="ApplyBtn" Content="写入 MAC" Style="{StaticResource PrimaryButton}"
                        Click="OnApply" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
