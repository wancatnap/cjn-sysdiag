<Window x:Class="SysDiag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统诊断台" Height="880" Width="1240" MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- 单张功能卡片 -->
        <DataTemplate x:Key="CardTemplate">
            <Button Style="{StaticResource CardButton}" Click="OnCardClick" Tag="{Binding}" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{Binding TintBrush}"
                            VerticalAlignment="Top" Margin="0,1,10,0">
                        <TextBlock Text="{Binding Badge}" Foreground="{Binding AccentBrush}"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Width="112" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Desc}" FontSize="11.5" Foreground="{StaticResource InkTertiary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="32" LineHeight="16"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 一个分组 -->
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
                    <Border Width="3" Height="17" CornerRadius="2" Background="{Binding AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountText}" FontSize="11.5" Foreground="{StaticResource InkFaint}"
                               Margin="9,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 权限状态 -->
        <Grid Grid.Row="0" Margin="32,26,32,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="系统诊断台" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"
                               VerticalAlignment="Center" />
                    <Border x:Name="AdminBadge" CornerRadius="7" Padding="9,3" Margin="11,0,0,0"
                            VerticalAlignment="Center" Background="#F1F3F5"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="AdminBadgeText" Text="普通权限" FontSize="10.5"
                                   Foreground="{StaticResource InkTertiary}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubTitle" FontSize="12.5" Foreground="{StaticResource InkTertiary}"
                           Margin="0,8,0,0" />
            </StackPanel>

            <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnElevate"
                    Visibility="Collapsed"
                    ToolTip="重启整个程序并请求管理员权限，用于读取 USN 文件删除记录" />
        </Grid>

        <!-- 搜索 -->
        <Grid Grid.Row="1" Margin="32,18,32,8">
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}"
                     Padding="42,0,14,0" TextChanged="OnSearchChanged" />

            <!-- 放大镜（矢量，不用 emoji） -->
            <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Margin="16,0,0,0" IsHitTestVisible="False">
                <Ellipse Width="11" Height="11" Stroke="{StaticResource InkFaint}" StrokeThickness="1.5"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Line X1="10" Y1="10" X2="14.5" Y2="14.5" Stroke="{StaticResource InkFaint}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>

            <TextBlock x:Name="SearchHint" Text="输入关键字过滤，例如「日志」「网络」「SMART」"
                       FontSize="13" Foreground="{StaticResource InkFaint}" Margin="42,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <!-- 卡片区 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="32,0,20,0">
            <ItemsControl x:Name="GroupList" ItemTemplate="{StaticResource GroupTemplate}"
                          Margin="0,0,8,20">
                <ItemsControl.RenderTransform>
                    <TranslateTransform Y="10" />
                </ItemsControl.RenderTransform>
                <ItemsControl.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.35" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="10" To="0" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ItemsControl.Triggers>
            </ItemsControl>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,0">
            <Grid Height="52">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{StaticResource InkTertiary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="打开报告目录" Style="{StaticResource GhostButton}" Click="OnOpenOutput" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 分析中遮罩 -->
        <Border x:Name="Busy" Grid.Row="0" Grid.RowSpan="4" Background="#D9F4F5F8" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="30,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel Width="380">
                    <TextBlock x:Name="BusyTitle" Text="正在处理" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="BusyText" Text="准备中…" FontSize="11.5"
                               Foreground="{StaticResource InkTertiary}"
                               Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="17" />
                    <ProgressBar x:Name="BusyBar" Height="3" Margin="0,18,0,0" IsIndeterminate="True"
                                 Foreground="{StaticResource Primary}" Background="#EEF0F4" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
