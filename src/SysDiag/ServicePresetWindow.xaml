<Window x:Class="SysDiag.ServicePresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="服务预设" Height="760" Width="1020" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="服务预设" Badge="可还原" />

        <!-- 工具条 -->
        <Border Grid.Row="1" Margin="24,0,24,10" Padding="14,10" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="AllBtn" Content="全部" Style="{StaticResource ToolButton}" Click="OnFilterAll" />
                    <Button x:Name="SafeBtn" Content="只看可停" Style="{StaticResource ToolButton}" Click="OnFilterSafe" />
                    <Button x:Name="CarefulBtn" Content="只看谨慎" Style="{StaticResource ToolButton}" Click="OnFilterCareful" />
                </StackPanel>

                <TextBlock x:Name="HintText" Grid.Column="1" FontSize="10" Foreground="{StaticResource InkFaint}"
                           VerticalAlignment="Center" Margin="14,0,14,0" TextWrapping="Wrap"
                           Text="未选择任何项" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RestoreBtn" Content="还原全部改动" Style="{StaticResource ToolButton}"
                            Click="OnRestore" />
                    <Button x:Name="ApplyBtn" Content="禁用选中" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" MinWidth="96" Click="OnApply" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ListScroll" Grid.Row="2" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ItemHost" Margin="0,0,0,10" />
        </ScrollViewer>

        <controls:BottomBar x:Name="Bar" Grid.Row="3" Margin="0,10,0,0" />
    </Grid>
</Window>
