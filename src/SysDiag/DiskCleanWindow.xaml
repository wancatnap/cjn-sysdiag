<Window x:Class="SysDiag.DiskCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C 盘清理" Height="880" Width="1040" MinHeight="640" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 容量条：只用 PART_Track / PART_Indicator 两个必需部件 -->
        <Style x:Key="UsageBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaise}" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="C 盘清理" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource PageBadge}">
                    <TextBlock Text="打开即自动扫描" FontSize="9.5" Foreground="{StaticResource Primary}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 容量与权限 -->
        <Border Grid.Row="1" Margin="24,2,24,0" Padding="16,13" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="CapText" Text="正在读取磁盘信息…" FontSize="12"
                               Foreground="{StaticResource InkSecondary}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CleanableText" Text="" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Primary}" HorizontalAlignment="Right" />
                </Grid>

                <ProgressBar x:Name="UsageBar" Style="{StaticResource UsageBarStyle}" Margin="0,9,0,0" Value="0" />

                <Grid Margin="0,7,0,0">
                    <TextBlock x:Name="FreeText" Text="" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="AdminHint" FontSize="10.5" Foreground="{StaticResource Warn}"
                               HorizontalAlignment="Right" Visibility="Collapsed"
                               Text="普通权限：系统目录只能清掉一部分，点右下角「以管理员身份重启」可清得更彻底。" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Grid Grid.Row="2" Margin="24,12,24,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="全选安全项" Style="{StaticResource ToolButton}" Margin="0" Click="OnSelectSafe" />
                <Button Content="清空选择" Style="{StaticResource ToolButton}" Click="OnClearSelection" />
                <Button Content="重新扫描" Style="{StaticResource ToolButton}" Click="OnRescan" />
                <Button x:Name="DeepBtn" Content="分析 C 盘目录占用" Style="{StaticResource ToolButton}" Click="OnDeepScan" />
            </StackPanel>
            <TextBlock x:Name="ScanHint" Text="准备扫描…" FontSize="11" Foreground="{StaticResource InkTertiary}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="360" />
        </Grid>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="3" Margin="24,0,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,8">
                <ItemsControl x:Name="TargetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanClean}" VerticalAlignment="Top"
                                              Margin="2,3,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                            <Border Background="{StaticResource SurfaceRaise}" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,0" Margin="8,1,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{StaticResource InkFaint}" />
                                            </Border>
                                            <Border Background="Transparent" BorderBrush="{Binding LevelBrush}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,0" Margin="6,1,0,0">
                                                <TextBlock Text="{Binding LevelText}" FontSize="9" Foreground="{Binding LevelBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{StaticResource InkFaint}"
                                                   Margin="0,5,12,0" TextWrapping="Wrap" LineHeight="15" />

                                        <TextBlock Text="{Binding PathText}" FontSize="9.5" FontFamily="Consolas"
                                                   Foreground="{StaticResource InkTertiary}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="10,1,0,0" MinWidth="86">
                                        <TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                                   TextAlignment="Right" />
                                        <TextBlock Text="{Binding CountText}" FontSize="9.5"
                                                   Foreground="{StaticResource InkFaint}" TextAlignment="Right"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint" Text="正在扫描 C 盘…" FontSize="11"
                           Foreground="{StaticResource InkTertiary}" Margin="4,10,0,0" />

                <!-- 深度分析结果 -->
                <Border x:Name="DeepPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,12"
                        Background="{StaticResource SurfaceRaise}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,9,0"
                                    Background="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="C 盘顶层目录占用" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeepHint" FontSize="10" Foreground="{StaticResource InkFaint}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl x:Name="RootList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                   Foreground="{StaticResource InkSecondary}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Border Grid.Column="1" Height="6" CornerRadius="3" Margin="10,0,12,0"
                                                Background="{StaticResource LineSoft}" VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" CornerRadius="3"
                                                    Background="{StaticResource Accent}" Width="{Binding BarWidth}" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" FontFamily="Consolas"
                                                       Foreground="{StaticResource Ink}" MinWidth="76" TextAlignment="Right" />
                                            <TextBlock Text="{Binding PercentText}" FontSize="10" FontFamily="Consolas"
                                                       Foreground="{StaticResource InkFaint}" MinWidth="52" TextAlignment="Right"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock FontSize="9.5" Foreground="{StaticResource InkFaint}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" LineHeight="15"
                                   Text="只统计文件逻辑大小，不含硬链接去重，WinSxS 等目录会显得偏大。这里只做展示，不提供删除入口。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="SummaryText" Text="未选择任何项" FontSize="12" Foreground="{StaticResource Ink}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <CheckBox x:Name="DirectMode" IsChecked="True" VerticalAlignment="Center"
                                  Foreground="{StaticResource InkSecondary}" FontSize="10.5"
                                  Content="安全项直接删除"
                                  ToolTip="勾选：安全项直接删除，立即释放空间；谨慎项仍然进回收站。不勾：全部进回收站，可还原。" />
                        <TextBlock FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="（立即释放；谨慎项始终进回收站，清空回收站才真正释放）" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="CleanBtn" Content="清理选中项" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="OnClean" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
