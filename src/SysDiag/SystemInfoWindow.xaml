<Window x:Class="SysDiag.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="系统信息" Height="880" Width="1080" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="系统信息" Badge="软件内直接查看" />

        <!-- 精简判定结论 -->
        <Border x:Name="VerdictBox" Grid.Row="1" Margin="24,0,24,0" Padding="16,14" CornerRadius="8"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="VerdictIcon" Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                        Background="{StaticResource SurfaceRaise}" BorderThickness="1"
                        BorderBrush="{StaticResource Line}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock x:Name="VerdictGlyph" Text="?" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource InkFaint}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="VerdictTitle" Text="正在检测…" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="VerdictDetail" Text="" FontSize="11" LineHeight="18"
                               Foreground="{StaticResource InkTertiary}" Margin="0,5,10,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RescanBtn" Content="重新检测" Style="{StaticResource ToolButton}" Click="OnRescan" />
                    <Button x:Name="CopyBtn" Content="复制摘要" Style="{StaticResource ToolButton}" Click="OnCopy" />
                    <Button x:Name="ReportBtn" Content="生成报告" Style="{StaticResource PrimaryButton}" Click="OnReport" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 精简检测 KPI -->
        <Border Grid.Row="2" Margin="24,10,24,0" Padding="16,11" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <controls:KpiStrip x:Name="Kpi" VerticalAlignment="Center" />
        </Border>

        <!-- 精简检测明细 -->
        <Border Grid.Row="3" Margin="24,10,24,0" Padding="14,12" CornerRadius="9"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,9,0"
                            Background="{StaticResource Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="精简系统检测" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TrimHint" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl x:Name="TrimList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="46" Height="18" CornerRadius="3"
                                                BorderBrush="{Binding LevelBrush}" BorderThickness="1"
                                                VerticalAlignment="Top" Margin="0,1,10,0">
                                            <TextBlock Text="{Binding LevelText}" FontSize="9"
                                                       Foreground="{Binding LevelBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" />
                                                <Border Background="{StaticResource SurfaceRaise}" CornerRadius="3"
                                                        Padding="6,0" Margin="8,1,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9"
                                                               Foreground="{StaticResource InkFaint}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                                       Foreground="{StaticResource InkTertiary}"
                                                       TextWrapping="Wrap" LineHeight="15" Margin="0,3,12,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 系统信息明细 -->
        <ScrollViewer Grid.Row="4" Margin="24,10,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GroupList" Margin="0,0,8,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,9,0"
                                            Background="{StaticResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Note}" FontSize="9.5"
                                               Foreground="{StaticResource InkFaint}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10.5"
                                                           Foreground="{StaticResource InkSecondary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="10.5"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="{StaticResource Ink}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:BottomBar x:Name="Bar" Grid.Row="5" Margin="0,4,0,0" />
    </Grid>
</Window>
