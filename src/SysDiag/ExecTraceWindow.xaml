<Window x:Class="SysDiag.ExecTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="程序执行记录" Height="840" Width="1020" MinHeight="640" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="ExecTemplate">
            <Border Padding="11,8" Margin="0,0,0,6" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="10.5"
                               FontFamily="Consolas" Foreground="{StaticResource Primary}"
                               VerticalAlignment="Top" Margin="0,2,10,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <Border Background="{StaticResource SurfaceRaise}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding SourceText}" FontSize="9" Foreground="{StaticResource InkFaint}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding PathText}" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource InkTertiary}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding MetaText}" FontSize="9.5" Foreground="{StaticResource InkFaint}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="程序执行记录" Style="{StaticResource PageTitle}" />
            <TextBlock Text="全部只读；AmCache 是加载副本 hive，读完立刻卸载，不改动原文件。"
                       FontSize="11.5" Foreground="{StaticResource InkFaint}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 权限提示 -->
        <Border x:Name="AdminBanner" Grid.Row="1" Margin="24,0,24,0" Padding="14,9" CornerRadius="10"
                Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Warn}" />
                <TextBlock x:Name="AdminDetail" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="BAM 记录、Amcache.hve、SRUDB.dat 三处都在受保护位置，普通权限读不到。点右下角「以管理员身份重启」，重启后自动回到本窗口并重新读取。" />
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border Grid.Row="2" Margin="24,4,24,0" Padding="14,10" CornerRadius="10"
                Background="{StaticResource SurfaceRaise}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="SummaryText" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640"
                           HorizontalAlignment="Left" Text="正在读取…" />
                <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource ToolButton}"
                        HorizontalAlignment="Right" Click="OnRefresh" />
            </Grid>
        </Border>

        <!-- 结果（统一表格） -->
        <Grid Grid.Row="3" Margin="24,12,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="SrumBadge" Grid.Row="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SRUM" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SrumBadgeText" FontSize="10.5" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SrumDetail" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <controls:LogGridView x:Name="BamGrid" Grid.Row="1" />
            <controls:LogGridView x:Name="AmcGrid" Grid.Row="2" Margin="0,10,0,0" />
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="540"
                           HorizontalAlignment="Left" Text="正在读取…" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                    <Button x:Name="ReportBtn" Content="生成报告" Style="{StaticResource ToolButton}"
                            Click="OnReport" IsEnabled="False" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
