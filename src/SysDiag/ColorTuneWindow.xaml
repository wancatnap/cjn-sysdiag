<Window x:Class="SysDiag.ColorTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="手动调色" Height="820" Width="1100" MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="手动调色" Badge="实时写显卡 LUT" />

        <!-- 显示器 + 实时开关 + 还原 -->
        <Border Grid.Row="1" Margin="24,0,24,0" Padding="16,12" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="显示器" FontSize="11" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="MonitorCombo" Width="230" SelectionChanged="OnMonitorChanged"
                              VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LutStateText" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TuneSummaryText" FontSize="9.5" Foreground="{StaticResource InkFaint}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="RealtimeCheck" Content="实时预览" IsChecked="True" FontSize="10.5"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="ApplyBtn" Content="应用" Style="{StaticResource PrimaryButton}"
                            Click="OnApply" />
                    <Button x:Name="RestoreBtn" Content="还原" Style="{StaticResource ToolButton}"
                            Click="OnRestore" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.02*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：参数 -->
            <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="10" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0">
                        <StackPanel Margin="16,14,16,10">

                            <TextBlock Text="调整" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,0,0,2" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gamma" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="GammaSlider" Grid.Column="1" Minimum="0.40" Maximum="3.00"
                                        Value="1.00" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="GammaValue" Grid.Column="2" Text="1.00" FontSize="10.5"
                                           FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="亮度" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-50" Maximum="50"
                                        Value="0" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="BrightnessValue" Grid.Column="2" Text="0%" FontSize="10.5"
                                           FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="对比度" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="0.50" Maximum="2.00"
                                        Value="1.00" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="ContrastValue" Grid.Column="2" Text="1.00" FontSize="10.5"
                                           FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,4" />

                            <TextBlock Text="RGB 增益（调白平衡）" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,6,0,0" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="红 R" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="GainRSlider" Grid.Column="1" Minimum="0.50" Maximum="2.00"
                                        Value="1.00" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="GainRValue" Grid.Column="2" Text="1.00" FontSize="10.5"
                                           FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="绿 G" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="GainGSlider" Grid.Column="1" Minimum="0.50" Maximum="2.00"
                                        Value="1.00" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="GainGValue" Grid.Column="2" Text="1.00" FontSize="10.5"
                                           FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="蓝 B" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="GainBSlider" Grid.Column="1" Minimum="0.50" Maximum="2.00"
                                        Value="1.00" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="GainBValue" Grid.Column="2" Text="1.00" FontSize="10.5"
                                           FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,4" />

                            <TextBlock Text="快速方案" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,6,0,0" />

                            <WrapPanel x:Name="QuickHost" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 预设与导出 -->
                    <StackPanel Grid.Row="1" Margin="16,8,16,14">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="PresetCombo" Grid.Column="0" Height="26"
                                      SelectionChanged="OnPresetSelected" />
                            <Button Grid.Column="1" Content="删除" Style="{StaticResource ToolButton}"
                                    Margin="8,0,0,0" Click="OnDeletePreset" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PresetNameBox" Grid.Column="0" Height="26" Padding="8,0"
                                     VerticalContentAlignment="Center" FontSize="10.5" />
                            <Button Grid.Column="1" Content="保存方案" Style="{StaticResource ToolButton}"
                                    Margin="8,0,0,0" Click="OnSavePreset" />
                            <Button Grid.Column="2" Content="导出 ICC…" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Click="OnExportIcc" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：曲线 + 预览 -->
            <Border Grid.Column="1" CornerRadius="10" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14,16,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="色调曲线" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <TextBlock Text="横轴输入 · 纵轴输出 · 虚线为不调整" FontSize="9.5"
                                       Foreground="{StaticResource InkFaint}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Margin="0,8,0,0" CornerRadius="8" Background="{StaticResource Canvas}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                            <Canvas x:Name="CurveCanvas" Height="220" SizeChanged="OnCurveSizeChanged" />
                        </Border>

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="调整前后对比" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <TextBlock Text="拖动中间竖线：左原始 / 右调整后" FontSize="9.5"
                                           Foreground="{StaticResource InkFaint}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="PickImageBtn" Content="换底图…"
                                        Style="{StaticResource ToolButton}" Padding="9,3" FontSize="10"
                                        Click="OnPickImage" />
                                <Button x:Name="ClearImageBtn" Content="用色卡"
                                        Style="{StaticResource ToolButton}" Padding="9,3" FontSize="10"
                                        Margin="6,0,0,0" Click="OnClearImage" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="CompareHost" Height="250" Margin="0,8,0,0" CornerRadius="8"
                                Background="#12161C" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" ClipToBounds="True" Cursor="SizeWE"
                                MouseLeftButtonDown="OnCompareDown" MouseMove="OnCompareMove"
                                MouseLeftButtonUp="OnCompareUp" SizeChanged="OnCompareSizeChanged">
                            <Grid>
                                <Grid x:Name="BeforeLayer" />

                                <Grid x:Name="AfterLayer">
                                    <Grid.Clip>
                                        <RectangleGeometry x:Name="AfterClip" Rect="0,0,0,0" />
                                    </Grid.Clip>
                                </Grid>

                                <Line x:Name="SplitLine" X1="0" X2="0" Y1="0" Y2="186"
                                      Stroke="{StaticResource Primary}" StrokeThickness="2"
                                      IsHitTestVisible="False" />

                                <Border x:Name="SplitHandle" Width="20" Height="20" CornerRadius="10"
                                        Background="{StaticResource Primary}" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" IsHitTestVisible="False" />

                                <TextBlock Text="原始" FontSize="9" Foreground="White" Margin="8,6,0,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           IsHitTestVisible="False" />
                                <TextBlock Text="调整后" FontSize="9" Foreground="White" Margin="0,6,8,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           IsHitTestVisible="False" />

                                <!-- 没有底图时盖一条提示：光靠下方文字会被滚出可视区 -->
                                <Border x:Name="NoRefHint" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Margin="0,0,0,10" CornerRadius="11" Background="#C4000000"
                                        Padding="12,5" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock Text="还没有底图 · 点右上角「换底图…」用自己的截图"
                                               FontSize="10" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="NoteText" FontSize="9.5" Foreground="{StaticResource InkFaint}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <controls:BottomBar x:Name="Bar" Grid.Row="3" Margin="0,4,0,0" />
    </Grid>
</Window>
