<Window x:Class="SysDiag.BigFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="大文件管理" Height="760" Width="1080" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="FileHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceRaise}" />
            <Setter Property="Foreground" Value="{StaticResource InkTertiary}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="大文件管理" Badge="只找不改" />

        <!-- 扫描条件 -->
        <Border Grid.Row="1" Margin="24,0,24,10" Padding="16,12" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="扫描范围" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="DrivePanel" Orientation="Horizontal" Margin="8,0,0,0" />

                    <TextBlock Text="大于" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" Margin="18,0,6,0" />
                    <ComboBox x:Name="SizeCombo" Width="110" FontSize="10.5" />

                    <Button x:Name="ScanBtn" Content="开始扫描" Style="{StaticResource PrimaryButton}"
                            Margin="14,0,0,0" MinWidth="96" Click="OnScan" />
                    <Button x:Name="CancelBtn" Content="停止" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnCancel" />
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Text="选好范围后点「开始扫描」。系统目录（Windows / Program Files）不进入，避免拖慢也避免误删。" />
                    <ProgressBar x:Name="Bar" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                                 IsIndeterminate="True" Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 结果列表 -->
        <Border Grid.Row="2" Margin="24,0,24,0" CornerRadius="10" ClipToBounds="True"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ListView x:Name="FileList" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnRowDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource FileHeader}">
                        <GridViewColumn Header="文件名" Width="250"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="大小" Width="96"
                                        DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="类型" Width="80"
                                        DisplayMemberBinding="{Binding Kind}" />
                        <GridViewColumn Header="最后访问" Width="130"
                                        DisplayMemberBinding="{Binding LastAccessText}" />
                        <GridViewColumn Header="所在目录" Width="430"
                                        DisplayMemberBinding="{Binding Folder}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 底部操作 -->
        <Border Grid.Row="3" Margin="24,12,24,20" Padding="16,10" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TotalText" Text="还没有结果" FontSize="10.5"
                               Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="　·　双击一行打开所在文件夹" FontSize="9.5"
                               Foreground="{StaticResource InkFaint}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenBtn" Content="打开位置" Style="{StaticResource ToolButton}"
                            IsEnabled="False" Click="OnOpenFolder" />
                    <Button x:Name="DeleteBtn" Content="移入回收站" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnDelete" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
