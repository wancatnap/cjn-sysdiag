<Window x:Class="SysDiag.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="内存" Height="720" Width="900" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,8" Title="内存" Badge="实时" />

        <!-- 总量 + 构成 -->
        <Border Grid.Row="1" Margin="24,0,24,10" Padding="16,14" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <controls:KpiStrip x:Name="Kpi" />

                <Grid x:Name="BarHost" Height="8" Margin="0,14,0,0">
                    <Grid x:Name="BarInner" />
                </Grid>

                <StackPanel x:Name="LegendHost" Orientation="Horizontal" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- 工具条：排序 + 动作 -->
        <Border Grid.Row="2" Margin="24,0,24,10" Padding="14,10" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ComboBox x:Name="SortCombo" Width="128" Height="28" FontSize="11.5"
                              VerticalContentAlignment="Center" SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="按工作集" IsSelected="True" />
                        <ComboBoxItem Content="按私有内存" />
                        <ComboBoxItem Content="按提交大小" />
                    </ComboBox>
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="OnRefresh" />
                </StackPanel>

                <TextBlock x:Name="SelText" Grid.Column="1" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                           VerticalAlignment="Center" Margin="14,0,14,0" TextTrimming="CharacterEllipsis"
                           Text="" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PickBtn" Content="勾选可见" Style="{StaticResource ToolButton}" Click="OnTogglePick" />
                    <Button x:Name="ReclaimBtn" Content="回收选中" Style="{StaticResource ToolButton}"
                            IsEnabled="False" Click="OnReclaim" />
                    <Button x:Name="PurgeBtn" Content="清理待机列表" Style="{StaticResource PrimaryButton}"
                            MinWidth="110" Click="OnPurge" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 进程排行 -->
        <Border Grid.Row="3" Margin="24,0,24,0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="进程" FontSize="10" Foreground="{StaticResource InkFaint}" />
                    <TextBlock Grid.Column="2" Text="工作集" FontSize="10" Foreground="{StaticResource InkFaint}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="私有" FontSize="10" Foreground="{StaticResource InkFaint}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="提交" FontSize="10" Foreground="{StaticResource InkFaint}" TextAlignment="Right" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel x:Name="RowHost" Margin="14,0,14,0" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 只读诊断 -->
        <TextBlock x:Name="DiagText" Grid.Row="4" Margin="26,10,24,0" FontSize="10"
                   Foreground="{StaticResource InkFaint}" TextTrimming="CharacterEllipsis" Text="" />

        <controls:BottomBar x:Name="Bar2" Grid.Row="5" Margin="0,10,0,0" />
    </Grid>
</Window>
