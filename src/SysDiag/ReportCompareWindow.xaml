<Window x:Class="SysDiag.ReportCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报告对比" Height="860" Width="1040" MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="报告对比" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource PageBadge}">
                    <TextBlock Text=".sdreport · 可拖入" FontSize="9.5" Foreground="{StaticResource Primary}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 两个槽位 -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SlotA" Grid.Column="0" Padding="14,12" CornerRadius="6" Cursor="Hand"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    MouseLeftButtonUp="OnPickA">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource SurfaceRaise}" CornerRadius="3" Padding="6,1">
                            <TextBlock Text="A 基准" FontSize="9.5" Foreground="{StaticResource Primary}" />
                        </Border>
                        <TextBlock x:Name="SlotAFile" Text="点击选择 .sdreport，或拖入" FontSize="11"
                                   Foreground="{StaticResource InkTertiary}" Margin="8,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="SlotAMeta" Text="" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="SlotB" Grid.Column="2" Padding="14,12" CornerRadius="6" Cursor="Hand"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    MouseLeftButtonUp="OnPickB">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource SurfaceRaise}" CornerRadius="3" Padding="6,1">
                            <TextBlock Text="B 对比" FontSize="9.5" Foreground="{StaticResource Accent}" />
                        </Border>
                        <TextBlock x:Name="SlotBFile" Text="点击选择 .sdreport，或拖入" FontSize="11"
                                   Foreground="{StaticResource InkTertiary}" Margin="8,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="SlotBMeta" Text="" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 工具条 -->
        <Grid Grid.Row="2" Margin="24,12,24,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="选择 A…" Style="{StaticResource ToolButton}" Margin="0" Click="OnPickA" />
                <Button Content="选择 B…" Style="{StaticResource ToolButton}" Click="OnPickB" />
                <Button Content="清空" Style="{StaticResource ToolButton}" Click="OnClear" />
                <Button x:Name="ExportBtn" Content="导出对比报告" Style="{StaticResource ToolButton}"
                        IsEnabled="False" Click="OnExport" />
            </StackPanel>
            <TextBlock x:Name="HintText" Text="等待导入…" FontSize="11" Foreground="{StaticResource InkTertiary}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="380" />
        </Grid>

        <!-- 对比列表 -->
        <ScrollViewer x:Name="ComparePanel" Grid.Row="3" Margin="24,0,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <ItemsControl x:Name="CompareList" Margin="0,0,8,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="Transparent" BorderBrush="{Binding ChangeBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="7,1" VerticalAlignment="Top"
                                        Margin="0,1,10,0">
                                    <TextBlock Text="{Binding ChangeText}" FontSize="9.5" Foreground="{Binding ChangeBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Group}" FontSize="9.5" Foreground="{StaticResource InkFaint}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LevelA}" FontSize="10" Foreground="{StaticResource InkTertiary}" />
                                    <TextBlock Text="→" FontSize="10" Foreground="{StaticResource InkFaint}" Margin="6,0" />
                                    <TextBlock Text="{Binding LevelB}" FontSize="10" Foreground="{StaticResource InkSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 单份浏览 -->
        <ScrollViewer x:Name="SinglePanel" Grid.Row="3" Margin="24,0,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SingleList" Margin="0,0,8,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="2,12,0,7">
                                <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,9,0"
                                        Background="{StaticResource Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Group}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource InkFaint}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" />
                                                <TextBlock Text="{Binding Basis}" FontSize="9.5" FontFamily="Consolas"
                                                           Foreground="{StaticResource InkTertiary}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,12" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Text="导入一份报告即可查看；导入两份自动对比。" FontSize="12"
                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ScoreText" Text="" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
