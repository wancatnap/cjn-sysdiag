<Window x:Class="SysDiag.LoggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志记录开关" Height="800" Width="900" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <StackPanel>
                <TextBlock Text="日志记录开关" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <Button Content="刷新状态" Style="{StaticResource ToolButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh" />
        </Grid>

        <!-- 开关列表 -->
        <Grid Grid.Row="1" Margin="24,0,16,0">
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{StaticResource Surface}" CornerRadius="9"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Wanted, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding AdminText}" FontSize="10.5"
                                               Foreground="{Binding AdminBrush}" Margin="10,2,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="{Binding StateBg}" CornerRadius="20"
                                    Padding="9,3" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                           Foreground="{Binding StateBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>


        <!-- 取证建议：容量与通道（只读） -->
        <Border Grid.Row="2" Margin="24,10,24,0" Padding="14,12" CornerRadius="9"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,9,0"
                            Background="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="取证建议：容量与通道" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <TextBlock x:Name="AdviceHint" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl x:Name="AdviceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" />
                                                <Border Background="{StaticResource SurfaceRaise}" CornerRadius="3"
                                                        Padding="6,0" Margin="8,1,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9"
                                                               Foreground="{StaticResource InkFaint}" />
                                                </Border>
                                                <Border Background="Transparent" BorderBrush="{Binding LevelBrush}"
                                                        BorderThickness="1" CornerRadius="3" Padding="6,0" Margin="6,1,0,0">
                                                    <TextBlock Text="{Binding LevelText}" FontSize="9"
                                                               Foreground="{Binding LevelBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock FontSize="10" Foreground="{StaticResource InkTertiary}"
                                                       Text="{Binding Advice}" TextWrapping="Wrap" LineHeight="15"
                                                       Margin="0,4,0,0" />
                                            <TextBlock FontSize="9.5" FontFamily="Consolas"
                                                       Foreground="{StaticResource InkFaint}"
                                                       Text="{Binding HowTo}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Current}" FontSize="12"
                                                   FontFamily="Consolas" Foreground="{StaticResource InkSecondary}"
                                                   VerticalAlignment="Top" MinWidth="72" TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="ApplyBtn" Content="应用更改" Style="{StaticResource PrimaryButton}"
                            Click="OnApply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
