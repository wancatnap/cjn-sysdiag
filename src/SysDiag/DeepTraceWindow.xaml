<Window x:Class="SysDiag.DeepTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="深度硬件痕迹" Height="820" Width="980" MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="深度硬件痕迹" Style="{StaticResource PageTitle}" />
            <TextBlock Text="全程只读，不改任何设置。"
                       FontSize="11.5" Foreground="{StaticResource InkFaint}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 结论条 -->
        <Border x:Name="VerdictBox" Grid.Row="1" Margin="24,4,24,0" Padding="16,12" CornerRadius="10"
                Background="{StaticResource SurfaceRaise}"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="VerdictBar" Grid.Column="0" CornerRadius="2" Margin="0,1,14,1" Background="{StaticResource Success}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="VerdictText" Text="正在体检…" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Success}" />
                    <TextBlock x:Name="VerdictDetail" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="CountText" FontSize="10" Foreground="{StaticResource InkFaint}"
                               FontFamily="Consolas" Margin="0,5,0,0" />
                </StackPanel>

                <Button x:Name="DeepBtn" Grid.Column="2" Content="深度扫描" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Margin="14,0,0,0" Click="OnDeep" />
            </Grid>
        </Border>

        <!-- 三组结果：全部展开、整页滚动。之前三组各占 1/3 高度各自内部滚动，
             每组只能露出一两行，是「太拥挤」的来源。 -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="2" Margin="24,12,24,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,2,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:LogGridView x:Name="DmaGrid" Grid.Row="0" />
                <controls:LogGridView x:Name="CaptureGrid" Grid.Row="1" Margin="0,18,0,0" />
                <controls:LogGridView x:Name="InputGrid" Grid.Row="2" Margin="0,18,0,0" />
            </Grid>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"
                           HorizontalAlignment="Left" Text="已完成快速体检。需要更深入时点右上角「深度扫描」。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ReportBtn" Content="生成报告" Style="{StaticResource ToolButton}"
                            Click="OnReport" IsEnabled="False" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
