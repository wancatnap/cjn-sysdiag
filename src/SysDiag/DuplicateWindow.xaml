<Window x:Class="SysDiag.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="重复文件" Height="760" Width="1000" MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10" Title="重复文件" Badge="只删到回收站" />

        <!-- 扫描条件 -->
        <Border Grid.Row="1" Margin="24,0,24,10" Padding="14,12" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="目录" FontSize="11" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="PathBox" Width="360" Height="28" FontSize="11"
                             VerticalContentAlignment="Center" />
                    <Button Content="浏览…" Style="{StaticResource ToolButton}" Click="OnBrowse" />

                    <TextBlock Text="最小" FontSize="11" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" Margin="14,0,8,0" />
                    <ComboBox x:Name="SizeBox" Width="96" Height="28" FontSize="11"
                              VerticalContentAlignment="Center" SelectedIndex="1">
                        <ComboBoxItem Content="256 KB" Tag="262144" />
                        <ComboBoxItem Content="1 MB" Tag="1048576" />
                        <ComboBoxItem Content="10 MB" Tag="10485760" />
                        <ComboBoxItem Content="100 MB" Tag="104857600" />
                    </ComboBox>

                    <Button x:Name="ScanBtn" Content="开始扫描" Style="{StaticResource PrimaryButton}"
                            MinWidth="96" Margin="12,0,0,0" Click="OnScan" />
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource ToolButton}"
                            IsEnabled="False" Click="OnCancel" />
                </WrapPanel>

                <TextBlock x:Name="StatusText" Text="选一个目录开始扫描。只比对内容，不看文件名。"
                           FontSize="10" Foreground="{StaticResource InkFaint}" Margin="0,9,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="2" Margin="24,0,24,0" CornerRadius="10" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="10,10,10,8">
                <StackPanel x:Name="GroupHost" />
            </ScrollViewer>
        </Border>

        <!-- 选区操作 -->
        <Border Grid.Row="3" Margin="24,10,24,0" Padding="14,10" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelText" Grid.Column="0" FontSize="11" Foreground="{StaticResource InkSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="还没有扫描结果" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="KeepOneBtn" Content="每组只留最早的" Style="{StaticResource ToolButton}"
                            Click="OnKeepOne" IsEnabled="False" />
                    <Button x:Name="ClearBtn" Content="取消全选" Style="{StaticResource ToolButton}"
                            Click="OnClear" IsEnabled="False" />
                    <Button x:Name="DeleteBtn" Content="删除选中" Style="{StaticResource PrimaryButton}"
                            MinWidth="96" Click="OnDelete" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:BottomBar x:Name="Bar" Grid.Row="4" Margin="0,10,0,0" />
    </Grid>
</Window>
