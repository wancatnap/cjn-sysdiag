<Window x:Class="SysDiag.IccWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="显示器配色" Height="820" Width="1000" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="显示器配色（ICC）" Badge="可导入导出" />

        <!-- 显示器 + 当前状态 -->
        <Border Grid.Row="1" Margin="24,0,24,0" Padding="16,13" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="显示器" FontSize="11" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="MonitorCombo" Width="230" SelectionChanged="OnMonitorChanged"
                              VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前配置" FontSize="11" Foreground="{StaticResource InkTertiary}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CurrentText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="StateBadge" Background="{StaticResource SurfaceRaise}" CornerRadius="7"
                                Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StateText" Text="系统默认" FontSize="9.5"
                                       Foreground="{StaticResource InkTertiary}" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="DetailText" FontSize="9.5" FontFamily="Consolas"
                               Foreground="{StaticResource InkFaint}" Margin="0,5,0,0"
                               TextWrapping="Wrap" LineHeight="15" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportBtn" Content="导入 ICC…" Style="{StaticResource ToolButton}"
                            Click="OnImport" />
                    <Button x:Name="ApplyBtn" Content="应用所选" Style="{StaticResource PrimaryButton}"
                            Click="OnApply" />
                    <Button x:Name="RestoreBtn" Content="恢复默认" Style="{StaticResource ToolButton}"
                            Click="OnRestore" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左：配置清单 / 右：预览 -->
        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="10" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,4">
                        <TextBlock Text="ICC 配置" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" FontSize="10" Foreground="{StaticResource InkFaint}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Button Content="刷新" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                                Padding="8,0" Height="24" Click="OnRefresh" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0,8,0">
                        <StackPanel x:Name="ProfileHost" Margin="8,4,8,8" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,6,16,12">
                        <Button x:Name="TuneBtn" Content="手动调色…" Style="{StaticResource PrimaryButton}"
                                Click="OnOpenTune" />
                        <Button x:Name="ExportBtn" Content="导出所选…" Style="{StaticResource ToolButton}"
                                Click="OnExport" />
                        <Button Content="打开配置目录" Style="{StaticResource ToolButton}" Click="OnOpenFolder" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="10" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,2">
                        <TextBlock Text="效果预览" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <TextBlock Text="近似：只按配置的亮度曲线换算，不做色域映射" FontSize="9.5"
                                   Foreground="{StaticResource InkFaint}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="原始" FontSize="9.5" Foreground="{StaticResource InkTertiary}"
                               Margin="16,10,16,4" />
                    <!-- 12 个色块按固定 6 列排（两行）：
                         用 UniformGrid 而不是 WrapPanel——WrapPanel 两组的换行点可能不同，
                         「原始」和「应用后」就错位了，而这一块的全部意义就是逐块对比。
                         UniformGrid 均分列宽，窗口拖窄也只是格子变窄，不会溢出。 -->
                    <UniformGrid x:Name="BeforeRow" Grid.Row="2" Columns="6" Margin="16,0,16,0" />

                    <StackPanel Grid.Row="3" Margin="16,0,16,0">
                        <TextBlock Text="应用后" FontSize="9.5" Foreground="{StaticResource InkTertiary}"
                                   Margin="0,10,0,4" />
                        <UniformGrid x:Name="AfterRow" Columns="6" />

                        <TextBlock x:Name="PreviewNote" FontSize="9.5" Foreground="{StaticResource InkFaint}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="15" />
                    </StackPanel>

                    <Border Grid.Row="4" Height="1" Background="{StaticResource Line}" Margin="16,14,16,0" />

                    <!-- 显卡 LUT：ICC 里唯一能让桌面/游戏肉眼可见的部分 -->
                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                        <StackPanel Margin="16,12,16,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="显卡 LUT" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <TextBlock Text="真正改变画面的那一步" FontSize="9.5"
                                           Foreground="{StaticResource InkFaint}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="LutStatusText" FontSize="10" Foreground="{StaticResource InkTertiary}"
                                       Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="16" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="强度" FontSize="10"
                                           Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center" />

                                <Slider x:Name="StrengthSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                        Value="100" SmallChange="1" LargeChange="10" Margin="10,0,10,0"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="StrengthText" Grid.Column="2" Text="100%" FontSize="10"
                                           FontFamily="Consolas" Foreground="{StaticResource Ink}"
                                           VerticalAlignment="Center" Width="38" TextAlignment="Right" />
                            </Grid>

                            <CheckBox x:Name="SynthCheck" Margin="0,10,0,0" FontSize="10.5"
                                      Content="配置不含校准表时，按它的色调曲线合成（近似）" />
                            <CheckBox x:Name="AutoCheck" Margin="0,7,0,0" FontSize="10.5"
                                      Content="下次启动时自动重新应用（重启后 LUT 会被系统重置）" />

                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <Button x:Name="LutApplyBtn" Content="只重写 LUT" Style="{StaticResource ToolButton}"
                                        Click="OnApplyLut" />
                                <Button x:Name="LutRestoreBtn" Content="还原 LUT" Style="{StaticResource ToolButton}"
                                        Click="OnRestoreLut" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <controls:BottomBar x:Name="Bar" Grid.Row="3" Margin="0,4,0,0" />
    </Grid>
</Window>
