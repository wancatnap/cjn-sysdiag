<Window x:Class="SysDiag.AutostartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="开机自启动" Height="710" Width="880" MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="开机自启动" Badge="两种方式" />

        <!-- 当前状态 -->
        <Border Grid.Row="1" Margin="24,0,24,0" Padding="16,13" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前状态" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <Border x:Name="StateBadge" Background="{StaticResource SurfaceRaise}" CornerRadius="7"
                                Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StateText" Text="读取中…" FontSize="10"
                                       Foreground="{StaticResource InkTertiary}" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="DetailText" FontSize="10" FontFamily="Consolas"
                               Foreground="{StaticResource InkSecondary}" Margin="0,7,0,0"
                               TextWrapping="Wrap" LineHeight="16" />
                </StackPanel>

                <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource ToolButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefresh" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="24,12,24,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,8">

                <!-- 方式一：当前用户 -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="方式一：当前用户" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource SuccessSoft}" BorderBrush="{StaticResource Success}"
                                        BorderThickness="1" CornerRadius="7" Padding="7,1" Margin="9,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="不需要管理员" FontSize="9.5" Foreground="{StaticResource Success}" />
                                </Border>
                            </StackPanel>

                            <TextBlock FontSize="10" Foreground="{StaticResource Warn}" Margin="0,5,0,0"
                                       TextWrapping="Wrap" LineHeight="16"
                                       Text="代价：改服务、写 HKLM 这类操作仍会弹 UAC，每次都要点一下。" />
                        </StackPanel>

                        <Button x:Name="UserBtn" Grid.Column="1" Content="用这种方式开启"
                                Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                                Click="OnEnableUser" />
                    </Grid>
                </Border>

                <!-- 方式二：计划任务 -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="方式二：计划任务（管理员）" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource PrimarySoft}" BorderBrush="{StaticResource PrimaryLine}"
                                        BorderThickness="1" CornerRadius="7" Padding="7,1" Margin="9,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="推荐" FontSize="9.5" Foreground="{StaticResource Primary}" />
                                </Border>
                            </StackPanel>

                                                                                </StackPanel>

                        <Button x:Name="AdminBtn" Grid.Column="1" Content="用这种方式开启"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                Click="OnEnableAdmin" />
                    </Grid>
                </Border>

                <!-- 关闭 -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="关闭自启动" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" />
                                                    </StackPanel>

                        <Button x:Name="DisableBtn" Grid.Column="1" Content="关闭自启动"
                                Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                                Click="OnDisable" />
                    </Grid>
                </Border>

                <!-- 说明 -->
                <Border Background="{StaticResource SurfaceRaise}" CornerRadius="10" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="它到底改了什么（可自行核对）" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="PathText" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource InkSecondary}" Margin="0,7,0,0"
                                   TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:BottomBar x:Name="Bar" Grid.Row="3" Margin="0,4,0,0" />
    </Grid>
</Window>
