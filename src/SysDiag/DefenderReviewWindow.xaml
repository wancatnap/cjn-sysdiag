<Window x:Class="SysDiag.DefenderReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="防护状态审查" Height="720" Width="1000" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="防护状态审查" Badge="只读" />

        <!-- 结论条 -->
        <Border Grid.Row="1" Margin="24,0,24,10" Padding="16,12" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="VerdictChip" CornerRadius="6" Padding="10,5"
                        Background="{StaticResource SuccessSoft}" VerticalAlignment="Center">
                    <TextBlock x:Name="VerdictText" Text="审查中…" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Success}" />
                </Border>

                <TextBlock x:Name="SummaryText" Grid.Column="1" FontSize="10.5" Margin="12,0,12,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource InkSecondary}"
                           Text="正在读取安全中心与 Defender 状态…" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="为什么没有关闭按钮" Style="{StaticResource ToolButton}"
                            Click="OnWhyNoDisable" />
                    <Button Content="重新审查" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                            Click="OnRefresh" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 关键状态 -->
            <Border Grid.Row="0" Margin="0,0,0,10" Padding="16,12" CornerRadius="10"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Defender" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                        <TextBlock x:Name="DefenderStateText" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="实时保护" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                        <TextBlock x:Name="RealTimeText" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="篡改防护" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                        <TextBlock x:Name="TamperText" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="被动模式" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                        <TextBlock x:Name="PassiveText" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="病毒库" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                        <TextBlock x:Name="SignatureText" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- 安全中心注册的产品 -->
                <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="10" ClipToBounds="True"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="安全中心注册的产品" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="14,10,14,6" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ProviderHost" Margin="14,0,14,12" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 审查结论 -->
                <Border Grid.Column="1" CornerRadius="10" ClipToBounds="True"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="审查结论" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="14,10,14,6" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="FindingHost" Margin="14,0,14,12" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:BottomBar x:Name="Bar" Grid.Row="3" Margin="0,10,0,0" />
    </Grid>
</Window>
