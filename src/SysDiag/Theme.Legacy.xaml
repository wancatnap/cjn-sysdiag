<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         旧版主题（界面优化前的样式，原样保留）
         用途：带 legacy-theme 参数启动时加载，用于对照与回退
         注意：下面第一段 token 只是为了让新版 MainWindow.xaml 能解析，
               色彩取旧版的值；真正的界面回退请用 legacy-ui/ 里的文件覆盖。
         ========================================================= -->

    <SolidColorBrush x:Key="Ink"          Color="#1F2937" />
    <SolidColorBrush x:Key="InkSecondary" Color="#495057" />
    <SolidColorBrush x:Key="InkTertiary"  Color="#868E96" />
    <SolidColorBrush x:Key="InkFaint"     Color="#ADB5BD" />
    <SolidColorBrush x:Key="Line"         Color="#E9ECEF" />
    <SolidColorBrush x:Key="LineSoft"     Color="#F1F3F5" />
    <SolidColorBrush x:Key="Surface"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Canvas"       Color="#F6F7F9" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F8F9FA" />

    <SolidColorBrush x:Key="Primary"      Color="#4C6EF5" />
    <SolidColorBrush x:Key="PrimarySoft"  Color="#EDF2FF" />
    <SolidColorBrush x:Key="PrimaryLine"  Color="#CED4DA" />
    <SolidColorBrush x:Key="PrimaryPress" Color="#3B5BDB" />

    <SolidColorBrush x:Key="Success"     Color="#2F9E44" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#EBFBEE" />
    <SolidColorBrush x:Key="Warn"        Color="#B08900" />
    <SolidColorBrush x:Key="WarnSoft"    Color="#FFF9DB" />
    <SolidColorBrush x:Key="Danger"      Color="#C92A2A" />
    <SolidColorBrush x:Key="DangerSoft"  Color="#FFF5F5" />
    <!-- 与暗色主题对齐的补充键（Legacy 原先缺这些，窗口引用会找不到资源） -->
    <SolidColorBrush x:Key="CanvasDeep"    Color="#EEF1F4" />
    <SolidColorBrush x:Key="SurfaceRaise"  Color="#EDF1F5" />
    <SolidColorBrush x:Key="LineBright"    Color="#CED4DA" />
    <SolidColorBrush x:Key="PrimaryDim"    Color="#1D4ED8" />
    <SolidColorBrush x:Key="Accent"        Color="#7048E8" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#F3F0FF" />

    <!-- 等级语义色（亮色版，与暗色主题同键名） -->
    <SolidColorBrush x:Key="LevelWarn"      Color="#C92A2A" />
    <SolidColorBrush x:Key="LevelWarnSoft"  Color="#FFF5F5" />
    <SolidColorBrush x:Key="LevelWarnLine"  Color="#E03131" />
    <SolidColorBrush x:Key="LevelWarnChip"  Color="#C92A2A" />
    <SolidColorBrush x:Key="LevelHint"      Color="#E67700" />
    <SolidColorBrush x:Key="LevelHintSoft"  Color="#FFF9DB" />
    <SolidColorBrush x:Key="LevelHintLine"  Color="#F59F00" />
    <SolidColorBrush x:Key="LevelHintChip"  Color="#E67700" />
    <SolidColorBrush x:Key="LevelOk"        Color="#2F9E44" />
    <SolidColorBrush x:Key="LevelOkSoft"    Color="#EBFBEE" />
    <SolidColorBrush x:Key="LevelOkLine"    Color="#40C057" />
    <SolidColorBrush x:Key="LevelOkChip"    Color="#2F9E44" />
    <SolidColorBrush x:Key="LevelKnown"     Color="#7048E8" />
    <SolidColorBrush x:Key="LevelKnownSoft" Color="#F3F0FF" />
    <SolidColorBrush x:Key="LevelKnownLine" Color="#7048E8" />
    <SolidColorBrush x:Key="LevelKnownChip" Color="#7048E8" />
    <SolidColorBrush x:Key="LevelNone"      Color="#868E96" />


    <!-- =========================================================
         以下是优化前的原始样式，一行未改
         ========================================================= -->

    <!-- 卡片按钮：白底圆角 + 悬停变化 -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="86" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="10"
                            Background="#FFFFFF"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1">
                        <ContentPresenter Margin="12,11,10,11"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F8F9FA" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#CED4DA" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F3F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏按钮 -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#495057" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#DEE2E6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F3F5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="#4C6EF5" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#4C6EF5" />
    </Style>

    <!-- 新版布局用到、旧版没有的样式：给等价定义，保证带 legacy-theme 参数时能起来 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style x:Key="SearchInput" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#DEE2E6" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>


    <!-- =========================================================
         页面骨架样式：标题 / 副标题 / 徽章 / KPI / 节标题 / 说明
         窗口里用 Style="{StaticResource Xxx}"，改这里＝全软件同改
         ========================================================= -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource InkTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="PageBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaise}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="Margin" Value="10,2,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource Primary}" />
    </Style>

    <Style x:Key="KpiItem" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,28,0" />
    </Style>

    <Style x:Key="KpiNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FootText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
    </Style>


    <DrawingImage x:Key="SakuraLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFB6C9">
                    <GeometryDrawing.Pen><Pen Brush="#EE8FAE" Thickness="0.9" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="20,11.6" RadiusX="5.3" RadiusY="8.8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFC2D2">
                    <GeometryDrawing.Pen><Pen Brush="#EE8FAE" Thickness="0.9" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="20,11.6" RadiusX="5.3" RadiusY="8.8">
                            <EllipseGeometry.Transform>
                                <RotateTransform Angle="72" CenterX="20" CenterY="20" />
                            </EllipseGeometry.Transform>
                        </EllipseGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFB6C9">
                    <GeometryDrawing.Pen><Pen Brush="#EE8FAE" Thickness="0.9" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="20,11.6" RadiusX="5.3" RadiusY="8.8">
                            <EllipseGeometry.Transform>
                                <RotateTransform Angle="144" CenterX="20" CenterY="20" />
                            </EllipseGeometry.Transform>
                        </EllipseGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFC2D2">
                    <GeometryDrawing.Pen><Pen Brush="#EE8FAE" Thickness="0.9" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="20,11.6" RadiusX="5.3" RadiusY="8.8">
                            <EllipseGeometry.Transform>
                                <RotateTransform Angle="216" CenterX="20" CenterY="20" />
                            </EllipseGeometry.Transform>
                        </EllipseGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFB6C9">
                    <GeometryDrawing.Pen><Pen Brush="#EE8FAE" Thickness="0.9" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="20,11.6" RadiusX="5.3" RadiusY="8.8">
                            <EllipseGeometry.Transform>
                                <RotateTransform Angle="288" CenterX="20" CenterY="20" />
                            </EllipseGeometry.Transform>
                        </EllipseGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFD666">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="20,20" RadiusX="3.4" RadiusY="3.4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="20,20" RadiusX="1.5" RadiusY="1.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>


    <!-- 顶部天空渐变（亮色变体；MainWindow 会引用，缺了会崩） -->
    <LinearGradientBrush x:Key="TopGlow" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFE9EFF8" Offset="0" />
        <GradientStop Color="#00EFF3F8" Offset="1" />
    </LinearGradientBrush>


    <!-- 网格底纹（亮色变体；MainWindow 引用，缺了会崩） -->
    <DrawingBrush x:Key="GridBg" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,32" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#F7F9FC" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                            <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#EDF1F7" Thickness="0.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 滚动条滑块（亮色变体） -->
    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="#C9D4E4" Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource PrimaryLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
