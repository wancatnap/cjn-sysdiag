<Window x:Class="SysDiag.UsnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="文件删除记录" Height="560" Width="800" MinHeight="440" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,20,24,12">
            <StackPanel>
                <TextBlock Text="文件删除记录" Style="{StaticResource PageTitle}" />
            </StackPanel>
        </Grid>

        <!-- 权限提示 -->
        <Border x:Name="AdminBanner" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="需要管理员权限" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Danger}" />
                <TextBlock x:Name="AdminDetail" Text="读取 USN 日志要打开磁盘卷句柄，普通权限拿不到。点下面的按钮会弹一次 UAC，以管理员身份重启整个程序；重启后自动回到这里并按当前选择开始读取。"
                           FontSize="11" Foreground="{StaticResource InkTertiary}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 参数（两行，给自定义区间留出空间） -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Margin="24,12,24,0" Padding="16,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="磁盘" FontSize="12" Foreground="{StaticResource InkSecondary}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="DriveBox" Width="90" Height="28" Margin="8,0,20,0"
                              VerticalContentAlignment="Center" />

                    <TextBlock Text="时间范围" FontSize="12" Foreground="{StaticResource InkSecondary}"
                               VerticalAlignment="Center" />
                    <controls:HourRangePicker x:Name="RangePicker" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="USN 日志按容量滚动覆盖，通常只保留最近几天到几周；选了过去的区间也可能读不到记录。"
                           FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="" />

        <!-- 底部 -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center"
                           Text="选择磁盘与时间范围，然后用右下角按钮开始读取。" TextTrimming="CharacterEllipsis" MaxWidth="430"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="ScanBtn" Content="开始读取" Style="{StaticResource PrimaryButton}"
                            Click="OnScan" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
