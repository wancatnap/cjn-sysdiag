<Window x:Class="SysDiag.GpuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="显卡" Height="620" Width="860" MinHeight="520" MinWidth="740"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="GpuTemplate">
            <Border Padding="14,10" Margin="0,0,0,6" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource InkTertiary}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RegistryText}" FontSize="10" Foreground="{StaticResource InkFaint}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PnpId}" FontSize="9.5" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <TextBlock Text="显卡检测 / 名称修改" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <Border x:Name="AdminBanner" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="AdminTitle" Text="改名需要管理员权限" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Danger}" />
                <TextBlock x:Name="AdminDetail" Text="写显卡注册表需要管理员。检测不受影响，可以先看信息再决定。"
                           FontSize="10.5" Foreground="{StaticResource InkTertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="刷新" Style="{StaticResource ToolButton}" Click="OnRefresh" />
                <TextBlock x:Name="ScanHint" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <ListBox x:Name="GpuList" Grid.Row="1" ItemTemplate="{StaticResource GpuTemplate}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnGpuChanged" />
        </Grid>

        <!-- 改名区 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Margin="24,10,24,0" Padding="16,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="显示名" FontSize="12" Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Width="300" Height="30" Margin="10,0,0,0"
                             Padding="8,0" VerticalContentAlignment="Center" FontSize="12.5" />
                    <Button Content="修改名称" Style="{StaticResource ToolButton}" Margin="10,0,0,0"
                            Click="OnRename" />
                    <Button Content="恢复原名" Style="{StaticResource ToolButton}" Click="OnRestore" />
                </StackPanel>
                <TextBlock x:Name="TipText"
                           Text="修改前会二次确认；改错了点「恢复原名」写回原始名称。重启或刷新设备管理器后生效。"
                           FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="480" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
