<Window x:Class="SysDiag.EvtxViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="事件查看器" Height="860" Width="1080" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="事件查看器" Badge="本机日志 · 内置" />

        <!-- 摘要 -->
        <Border Grid.Row="1" Margin="24,0,24,0" Padding="16,13" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <controls:KpiStrip x:Name="Kpi" VerticalAlignment="Center" />
                <TextBlock x:Name="StateText" Text="正在读取…" FontSize="11.5"
                           Foreground="{StaticResource InkSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
            </Grid>
        </Border>

        <!-- 工具条（两行：第一行选日志与时间，第二行条数与操作，避免自定义区间展开后被挤出窗口） -->
        <Grid Grid.Row="2" Margin="24,12,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="日志" FontSize="11" Foreground="{StaticResource InkSecondary}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="ChannelBox" Width="210" Height="28" FontSize="11" Margin="8,0,0,0"
                          VerticalContentAlignment="Center" SelectionChanged="OnChannelChanged" />

                <TextBlock Text="时间" FontSize="11" Foreground="{StaticResource InkSecondary}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
                <controls:HourRangePicker x:Name="RangePicker" Margin="8,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="条数" FontSize="11" Foreground="{StaticResource InkSecondary}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="MaxBox" Width="92" Height="28" FontSize="11" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="1" SelectionChanged="OnMaxChanged">
                        <ComboBoxItem Content="500" Tag="500" />
                        <ComboBoxItem Content="1500" Tag="1500" />
                        <ComboBoxItem Content="5000" Tag="5000" />
                        <ComboBoxItem Content="20000" Tag="20000" />
                    </ComboBox>

                    <Button x:Name="ReloadBtn" Content="刷新" Style="{StaticResource ToolButton}" Click="OnReload" />
                    <Button x:Name="ReportBtn" Content="生成报告" Style="{StaticResource ToolButton}"
                            IsEnabled="False" Click="OnReport" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="HintText" Text="" FontSize="11" Foreground="{StaticResource InkTertiary}"
                               VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                               MaxWidth="280" />
                    <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                            Click="OnElevate" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 列表 + 详情 -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:LogGridView x:Name="EventGrid" Grid.Row="0" />

            <Border x:Name="DetailBox" Grid.Row="1" Margin="0,8,0,0" Padding="14,10" CornerRadius="6"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="DetailTitle" Text="" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                        <Button Content="收起" Style="{StaticResource ToolButton}" HorizontalAlignment="Right"
                                Padding="10,0" Height="22" FontSize="10" Click="OnHideDetail" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="190" Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DetailText" Text="" FontSize="10.5" LineHeight="17"
                                   Foreground="{StaticResource InkSecondary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部 -->
        <controls:BottomBar x:Name="Bar" Grid.Row="4" Margin="0,4,0,0" />
    </Grid>
</Window>
