<Window x:Class="SysDiag.CheatScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="外挂痕迹体检" Height="900" Width="1060" MinHeight="660" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="外挂痕迹体检" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource PageBadge}">
                        <TextBlock Text="只读采集 · 不加载驱动" FontSize="9.5" Foreground="{StaticResource Primary}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="填写者" FontSize="10" Foreground="{StaticResource InkFaint}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="OperatorBox" Width="150" Height="28"
                             FontSize="10.5" VerticalContentAlignment="Center"
                             ToolTip="填名字或代号，会写进报告的「填写者」字段。留空则显示未填写。" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 结论卡 -->
        <Border Grid.Row="1" Margin="24,0,24,0" Padding="18,15" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ScoreRing" Grid.Column="0" Width="94" Height="94" CornerRadius="47"
                        Background="{StaticResource SurfaceRaise}" BorderThickness="2"
                        BorderBrush="{StaticResource LineBright}" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText" Text="—" FontSize="34" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource Ink}" TextAlignment="Center" />
                        <TextBlock x:Name="ScoreLevelText" Text="等待体检" FontSize="9.5"
                                   Foreground="{StaticResource InkFaint}" TextAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VerdictText" Text="正在体检…" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Text="正在依次执行 8 个只读采集项，请稍候。"
                               FontSize="10.5" Foreground="{StaticResource InkTertiary}" Margin="0,6,0,0"
                               TextWrapping="Wrap" LineHeight="16" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="WarnCount" Text="0" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource Danger}" TextAlignment="Center" />
                        <TextBlock Text="线索" FontSize="9.5" Foreground="{StaticResource InkFaint}" TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="HintCount" Text="0" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource LevelHint}" TextAlignment="Center" />
                        <TextBlock Text="提示" FontSize="9.5" Foreground="{StaticResource InkFaint}" TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="OkCount" Text="0" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource LevelOk}" TextAlignment="Center" />
                        <TextBlock Text="正常" FontSize="9.5" Foreground="{StaticResource InkFaint}" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具条 -->
        <Grid Grid.Row="2" Margin="24,12,24,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RescanBtn" Content="重新体检" Style="{StaticResource ToolButton}" Margin="0" Click="OnRescan" />
                <Button x:Name="ReportBtn" Content="报告" Style="{StaticResource ToolButton}"
                        IsEnabled="False" Click="OnReport" />
                <Button x:Name="PackBtn" Content="导出证据包" Style="{StaticResource ToolButton}" Click="OnPack" />
                <Button x:Name="ViewFindingsBtn" Content="发现" Style="{StaticResource ToolButton}" Click="OnShowFindings" />
                <Button x:Name="ViewTimelineBtn" Content="时间线" Style="{StaticResource ToolButton}" Click="OnShowTimeline" />
                <Button x:Name="ViewChecksBtn" Content="检查清单" Style="{StaticResource ToolButton}" Click="OnShowChecks" />
            </StackPanel>
            <!--  工具栏只放按钮。状态文字原来也在这里，6 个按钮 + 330px 的状态挤在同一行，
                  实际可用宽度不够，状态文字直接压在「检查清单」按钮上（截图确认过）。
                  现在状态挪到底部栏，跟耗时并排——那里才是"刚发生了什么"该出现的位置。  -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                        Click="OnElevate" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- 结果列表 -->
                <controls:LogGridView x:Name="FindingsGrid" Grid.Row="3" Margin="24,0,24,0" />
        <controls:LogGridView x:Name="TimelineGrid" Grid.Row="3" Margin="24,0,24,0" Visibility="Collapsed" />
        <controls:LogGridView x:Name="CheckGrid" Grid.Row="3" Margin="24,0,24,0" Visibility="Collapsed" />


        <!-- 底部：采集覆盖 + 按钮 -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,10" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="StageList" Grid.Column="0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceRaise}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,2,6,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="{StaticResource InkSecondary}"
                                               Margin="5,0,0,0" />
                                    <TextBlock Text="{Binding StateText}" FontSize="9" Foreground="{Binding StateBrush}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ScanHint" Text="准备开始" FontSize="10" Foreground="{StaticResource InkFaint}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="240" />
                    <TextBlock x:Name="ElapsedText" Text="" FontSize="10" Foreground="{StaticResource InkFaint}"
                               VerticalAlignment="Center" Margin="0,0,10,0" FontFamily="Consolas" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
