<Window x:Class="SysDiag.LogFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要分析的日志文件" Height="680" Width="940" MinHeight="480" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="24,20,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="选择要分析的文件" Style="{StaticResource PageTitle}" />
<TextBlock x:Name="RootText" Text="" FontSize="10" Foreground="{StaticResource InkFaint}"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1" Content="打开此目录" Style="{StaticResource ToolButton}"
                    VerticalAlignment="Center" Click="OnOpenFolder" />
        </Grid>

        <!-- 工具条 -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1"
                Padding="24,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleBtn" Content="全选" Style="{StaticResource ToolButton}" Margin="0,0,0,0" Click="OnToggleAll" />
                    <Button Content="只选最新一份" Style="{StaticResource ToolButton}" Click="OnSelectNewest" />
                    <Button Content="只选最近 3 份" Style="{StaticResource ToolButton}" Click="OnSelectRecent" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="OnlyLogCheck" Content="只看日志类文件" IsChecked="True"
                              FontSize="11.5" Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                    <CheckBox x:Name="SubdirCheck" Content="包含子目录" IsChecked="True"
                              FontSize="11.5" Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center"
                              Margin="16,0,0,0" Checked="OnScanOptionChanged" Unchecked="OnScanOptionChanged" />
                    <Button Content="重新扫描" Style="{StaticResource ToolButton}" Click="OnRescan" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文件列表 -->
        <Grid Grid.Row="2" Margin="24,10,16,0">
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="OnRowDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoft}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,10,0" Focusable="False" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                <TextBlock Text="{Binding WarnText}" FontSize="10" Foreground="{StaticResource LevelHintChip}"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnalyzable}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding KindText}" FontSize="10.5"
                                       Foreground="{Binding KindBrush}" VerticalAlignment="Center"
                                       MinWidth="52" TextAlignment="Right" Margin="12,0,0,0" />

                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                       MinWidth="82" TextAlignment="Right" Margin="14,0,0,0" />

                            <TextBlock Grid.Column="4" Text="{Binding TimeText}" FontSize="10.5"
                                       Foreground="{StaticResource InkFaint}" VerticalAlignment="Center"
                                       MinWidth="112" TextAlignment="Right" Margin="14,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Text="正在读取目录…" FontSize="12" Foreground="{StaticResource InkFaint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource ToolButton}" Click="OnCancel" />
                    <Button x:Name="AcceptBtn" Content="开始分析" Style="{StaticResource PrimaryButton}"
                            Click="OnAccept" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
