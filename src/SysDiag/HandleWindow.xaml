<Window x:Class="SysDiag.HandleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="进程句柄排查" Height="860" Width="1020" MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="进程句柄排查" Badge="谁在读游戏进程" />        <Border Grid.Row="1" Margin="24,0,24,0" Padding="16,13" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <controls:KpiStrip x:Name="Kpi" VerticalAlignment="Center" />

                <TextBlock x:Name="VerdictText" Text="先选目标进程" FontSize="11.5"
                           Foreground="{StaticResource InkSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </Grid>
        </Border>

        <!-- 工具条 -->
        <Grid Grid.Row="2" Margin="24,12,24,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="目标进程：" FontSize="11" Foreground="{StaticResource InkSecondary}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="TargetCombo" Width="280" Height="28" FontSize="11"
                          VerticalContentAlignment="Center" />
                <Button x:Name="RescanBtn" Content="开始扫描" Style="{StaticResource ToolButton}"
                        Margin="10,0,0,0" Click="OnScan" />
                <Button x:Name="ReportBtn" Content="生成报告" Style="{StaticResource ToolButton}"
                        IsEnabled="False" Click="OnReport" />
                <CheckBox x:Name="AutoRefreshBox" Content="自动刷新（10 秒）" FontSize="10.5"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ScanHint" Text="" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                        Click="OnElevate" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- 外部进程列表（统一表格） -->
        <controls:LogGridView x:Name="OwnerGrid" Grid.Row="3" Margin="24,4,24,0" />

        <!-- 底部 -->
        <controls:BottomBar x:Name="Bar" Grid.Row="4" Margin="0,4,0,0" />
    </Grid>
</Window>
