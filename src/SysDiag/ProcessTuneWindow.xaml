<Window x:Class="SysDiag.ProcessTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="优先级与 CPU 亲和性" Height="620" Width="640" MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="ProcessTitle" Text="进程" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CurrentText" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 优先级 -->
        <Border Grid.Row="1" Padding="14,12" CornerRadius="8" Margin="0,0,0,10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="优先级" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                <ComboBox x:Name="PriorityCombo" Height="30" Margin="0,9,0,0" FontSize="11.5"
                          VerticalContentAlignment="Center" />
                <TextBlock x:Name="PriorityNote" FontSize="10" Foreground="{StaticResource InkFaint}"
                           Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 亲和性 -->
        <Border Grid.Row="2" Padding="14,12" CornerRadius="8" Margin="0,0,0,10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="CPU 亲和性" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ToggleBtn" Content="全选" Style="{StaticResource ToolButton}" Click="OnToggleAll" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <Border Padding="14,12" CornerRadius="8"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <WrapPanel x:Name="CorePanel" />
                    <TextBlock x:Name="AffinityHint" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="12,10" CornerRadius="6" Margin="0,0,0,10"
                Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource ToolButton}" Click="OnCancel" />
            <Button x:Name="ApplyBtn" Content="应用" Style="{StaticResource PrimaryButton}" Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>
