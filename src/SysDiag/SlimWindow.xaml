<Window x:Class="SysDiag.SlimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="免重装精简" Height="820" Width="1080" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="免重装精简" Badge="不用重装" />

        <Border Grid.Row="1" Margin="24,8,24,0" Padding="16,12" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="ScanBtn" Content="扫描" Style="{StaticResource PrimaryButton}"
                            MinWidth="88" Click="OnScan" />
                    <Button x:Name="CancelBtn" Content="停止" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnCancel" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="10.5" Margin="16,0,12,0"
                           Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="点「扫描」列出可精简项。默认全不勾，请逐项确认后再执行。" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RemoveAppsBtn" Content="移除选中应用" Style="{StaticResource ToolButton}"
                            IsEnabled="False" Click="OnRemoveApps" />
                    <Button x:Name="DisableTasksBtn" Content="禁用选中任务" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnDisableTasks" />
                    <Button x:Name="RestoreBtn" Content="还原" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Click="OnRestore" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="24,12,24,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ItemHost" Margin="0,0,4,8" />
        </ScrollViewer>

        <controls:BottomBar x:Name="Bar" Grid.Row="3" Margin="0,10,0,0" />
    </Grid>
</Window>
