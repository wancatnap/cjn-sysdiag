<Window x:Class="SysDiag.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志清理" Height="800" Width="1020" MinHeight="580" MinWidth="840"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="日志清理" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="24,4,24,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="全选可清理" Style="{StaticResource ToolButton}" Margin="0" Click="OnSelectAll" />
                <Button Content="清空选择" Style="{StaticResource ToolButton}" Click="OnClearSelection" />
                <Button Content="全部展开" Style="{StaticResource ToolButton}" Click="OnExpandAll" />
                <Button Content="全部收起" Style="{StaticResource ToolButton}" Click="OnCollapseAll" />
                <Button Content="添加目录…" Style="{StaticResource ToolButton}" Click="OnAddFolder" />
                <Button Content="全盘查找游戏日志" Style="{StaticResource ToolButton}" Click="OnScanGames" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ScanHint" Text="扫描中…" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="重新扫描" Style="{StaticResource ToolButton}" Click="OnRefresh" />
            </StackPanel>
        </Grid>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,16,0">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}" CornerRadius="9" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Padding="10,8" Margin="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding GroupSelected, Mode=TwoWay}"
                                          IsThreeState="True" IsEnabled="{Binding CanDelete}"
                                          VerticalAlignment="Center" Margin="4,0,10,0"
                                          ToolTip="勾选整组；展开后可按单个文件勾选"
                                          PreviewMouseLeftButtonDown="OnGroupCheckPreview" />

                                <Expander Grid.Column="1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch" Background="Transparent"
                                          BorderThickness="0">
                                    <Expander.Header>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{StaticResource SurfaceRaise}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource InkTertiary}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedText}" FontSize="10" Foreground="{StaticResource Primary}"
                                                               Margin="8,1,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DisplayPath}" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10.5"
                                                       Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                       VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="76"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding KindText}" FontSize="10"
                                                       Foreground="{Binding KindBrush}" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" MinWidth="72" TextAlignment="Right" />
                                        </Grid>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding Files}" Margin="22,6,4,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                                                               Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"
                                                               Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center"
                                                               Margin="12,0,0,0" MinWidth="72" TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Text="未选择任何项" FontSize="12" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="⚠ 移入回收站后可还原；清空回收站则不可恢复。大小按文件逻辑大小统计，稀疏/压缩文件的实际释放可能更少。事件日志只展示体积，不提供删除。"
                               FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                    <Button x:Name="DeleteBtn" Content="移入回收站" Style="{StaticResource ToolButton}"
                            Background="{StaticResource LevelWarn}" Foreground="#FFFFFF" BorderBrush="{StaticResource LevelWarn}"
                            IsEnabled="False" Click="OnDelete" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
