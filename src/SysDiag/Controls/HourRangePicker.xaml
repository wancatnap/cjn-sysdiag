<UserControl x:Class="SysDiag.Controls.HourRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  时间区间选择：固定预设 + 自定义（按小时指定起止）。  -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="PresetBox" Width="126" Height="28" FontSize="11"
                  VerticalContentAlignment="Center" SelectionChanged="OnPresetChanged">
            <ComboBoxItem Content="最近 1 小时" Tag="1" />
            <ComboBoxItem Content="最近 24 小时" Tag="24" />
            <ComboBoxItem Content="最近 72 小时" Tag="72" />
            <ComboBoxItem Content="最近 7 天" Tag="168" />
            <ComboBoxItem Content="最近 30 天" Tag="720" />
            <ComboBoxItem Content="不限时间" Tag="0" />
            <ComboBoxItem Content="自定义区间…" Tag="custom" />
        </ComboBox>

        <!-- 自定义：起止日期 + 小时 -->
        <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Margin="8,0,0,0"
                    Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="从" FontSize="11" Foreground="{StaticResource InkSecondary}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker x:Name="FromDate" Width="118" Height="28" FontSize="11"
                        SelectedDateChanged="OnCustomChanged" />
            <ComboBox x:Name="FromHour" Width="72" Height="28" FontSize="11" Margin="6,0,0,0"
                      VerticalContentAlignment="Center" SelectionChanged="OnCustomChanged" />

            <TextBlock Text="到" FontSize="11" Foreground="{StaticResource InkSecondary}"
                       VerticalAlignment="Center" Margin="10,0,6,0" />
            <DatePicker x:Name="ToDate" Width="118" Height="28" FontSize="11"
                        SelectedDateChanged="OnCustomChanged" />
            <ComboBox x:Name="ToHour" Width="72" Height="28" FontSize="11" Margin="6,0,0,0"
                      VerticalContentAlignment="Center" SelectionChanged="OnCustomChanged" />
        </StackPanel>

        <TextBlock x:Name="HintText" Text="" FontSize="10" Foreground="{StaticResource InkFaint}"
                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="260" />
    </StackPanel>
</UserControl>
