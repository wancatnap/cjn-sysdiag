<UserControl x:Class="SysDiag.Controls.BottomBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  底部栏：只有耗时 + 关闭。刻意不放说明文字——
          需要解释的东西应该挪进布局或操作对话框，而不是常驻在每页底部当免责声明。  -->
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="24,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="ElapsedText" Style="{StaticResource MonoText}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button x:Name="CloseBtn" Content="关闭" Style="{StaticResource ToolButton}"
                    Click="OnCloseClick" />
        </StackPanel>
    </Border>
</UserControl>
