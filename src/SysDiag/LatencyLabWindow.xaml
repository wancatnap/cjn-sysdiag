<Window x:Class="SysDiag.LatencyLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="延迟实测 · 对照实验" Height="780" Width="1040" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="24,20,24,10"
                             Title="延迟实测 · 对照实验" Badge="只测不改" />

        <!-- 采样条件 -->
        <Border Grid.Row="1" Margin="24,0,24,10" Padding="16,12" CornerRadius="10"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="每轮时长" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="DurationCombo" Grid.Column="1" Width="88" Margin="8,0,0,0"
                          FontSize="10.5" VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="轮数" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
                <ComboBox x:Name="RunsCombo" Grid.Column="3" Width="72" Margin="8,0,0,0"
                          FontSize="10.5" VerticalAlignment="Center"
                          ToolTip="连跑多轮。第一轮即默认基线；同条件各轮之间的差异反映测量噪声本身有多大。" />

                <TextBox x:Name="LabelBox" Grid.Column="4" Margin="16,0,0,0" Height="28"
                         FontSize="10.5" VerticalContentAlignment="Center"
                         ToolTip="给这轮实验起名字，例如「只关了 Game Bar」。一次只改一项，名字里写清改了什么。" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="MeasureBtn" Content="开始测量" Style="{StaticResource PrimaryButton}"
                            MinWidth="92" Click="OnMeasure" />
                    <Button x:Name="CancelBtn" Content="停止" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnCancel" />
                    <Button x:Name="KernelBtn" Content="内核 DPC/ISR" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Click="OnCaptureKernel"
                            ToolTip="用 ETW 的 NT Kernel Logger 采集内核 DPC 单次执行时长。需要管理员权限；若 WPR / LatencyMon 正在录制会启动失败。" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 本轮结果 -->
            <Border Grid.Row="0" Margin="0,0,0,10" Padding="16,12" CornerRadius="10"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="本轮结果" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="ResultTitle" FontSize="10.5" Margin="10,3,0,0"
                                   Foreground="{StaticResource InkFaint}" Text="还没有数据" />
                    </StackPanel>

                    <!-- 抖动：用户态唤醒间隔 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="平均间隔" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="MeanText" Text="—" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="P95" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="P95Text" Text="—" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="P99（看这个）" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="P99Text" Text="—" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Primary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="最大尖峰" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="MaxText" Text="—" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 系统侧：不是抖动指标，用来解释抖动从哪来、以及停服务有没有真回收 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="计时器分辨率" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="TimerText" Text="—" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DPC / 中断占比" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="DpcText" Text="—" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="进程 / 线程 / 句柄" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="LoadText" Text="—" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSecondary}" Margin="0,3,0,0"
                                       ToolTip="停服务前后各存一次这个数，差值就是实际回收量。" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="内核 DPC" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                            <TextBlock x:Name="KernelText" Text="未采集" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSecondary}" Margin="0,3,0,0"
                                       ToolTip="内核 DPC 单次执行时长（ETW 采集，需管理员）。" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="StatusText" FontSize="10" Foreground="{StaticResource InkFaint}"
                               Margin="0,10,0,0" Text="未开始" />
                </StackPanel>
            </Border>

            <!-- 历史 + 对照 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="10" ClipToBounds="True"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="实验记录" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="14,10,14,6" />
                        <ListView x:Name="HistoryList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                  SelectionMode="Single" SelectionChanged="OnHistorySelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" Width="108"
                                                    DisplayMemberBinding="{Binding TimeText}" />
                                    <GridViewColumn Header="实验名称" Width="150"
                                                    DisplayMemberBinding="{Binding Label}" />
                                    <GridViewColumn Header="轮次" Width="62"
                                                    DisplayMemberBinding="{Binding RunText}" />
                                    <GridViewColumn Header="P99" Width="64"
                                                    DisplayMemberBinding="{Binding P99Text}" />
                                    <GridViewColumn Header="最大" Width="64"
                                                    DisplayMemberBinding="{Binding MaxText}" />
                                    <GridViewColumn Header="计时器" Width="82"
                                                    DisplayMemberBinding="{Binding TimerText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="0,0,0,0" Padding="14,10" CornerRadius="10"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="对照结论" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button x:Name="BaselineBtn" Content="设为基线" Style="{StaticResource ToolButton}"
                                    Click="OnSetBaseline" IsEnabled="False" />
                            <Button x:Name="CompareBtn" Content="与本轮对照" Style="{StaticResource ToolButton}"
                                    Click="OnCompare" IsEnabled="False" />
                            <TextBlock x:Name="BaselineText" FontSize="10" Foreground="{StaticResource InkFaint}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Text="未设基线" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="CompareText" FontSize="10.5" Foreground="{StaticResource InkSecondary}"
                                       TextWrapping="Wrap" LineHeight="17"
                                       Text="未对照" />
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="导出报告" Style="{StaticResource ToolButton}" Click="OnExport" />
                            <Button Content="删除选中" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                    Click="OnDelete" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:BottomBar x:Name="Bar" Grid.Row="3" Margin="0,10,0,0" />
    </Grid>
</Window>
