<Window x:Class="SysDiag.PrefetchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="本地执行痕迹" Height="860" Width="1020" MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="本地执行痕迹" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource PageBadge}">
                    <TextBlock Text="Prefetch · ShimCache" FontSize="9.5" Foreground="{StaticResource Primary}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 摘要 -->
        <Border Grid.Row="1" Margin="24,0,24,0" Padding="16,13" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="PrefetchCount" Text="—" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="PrefetchLabel" Text="Prefetch 记录" FontSize="9.5"
                                   Foreground="{StaticResource InkFaint}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="ShimCount" Text="0" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="ShimLabel" Text="ShimCache 条目" FontSize="9.5"
                                   Foreground="{StaticResource InkFaint}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="SuspiciousCount" Text="0" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource LevelHint}" />
                        <TextBlock Text="临时目录里的程序" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="VerdictText" Text="正在读取…" FontSize="11.5"
                           Foreground="{StaticResource InkSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </Grid>
        </Border>

        <!-- 工具条 -->
        <Grid Grid.Row="2" Margin="24,12,24,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RescanBtn" Content="重新扫描" Style="{StaticResource ToolButton}" Margin="0" Click="OnRescan" />
                <Button x:Name="ReportBtn" Content="生成报告" Style="{StaticResource ToolButton}"
                        IsEnabled="False" Click="OnReport" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ScanHint" Text="准备开始…" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                        Click="OnElevate" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- 列表（统一表格） -->
        <Grid Grid.Row="3" Margin="24,4,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:LogGridView x:Name="PrefetchGrid" Grid.Row="0" />
            <controls:LogGridView x:Name="ShimGrid" Grid.Row="1" Margin="0,10,0,0" />
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,12" Margin="0,4,0,0">
            <Grid>
                <TextBlock x:Name="Footnote" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="720"
                           HorizontalAlignment="Left"
                           Text="最后运行时间取 .pf 的写入时间；运行次数按版本布局读取，读不出来显示「—」而不是猜一个。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ElapsedText" Text="" FontSize="10" Foreground="{StaticResource InkFaint}"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
