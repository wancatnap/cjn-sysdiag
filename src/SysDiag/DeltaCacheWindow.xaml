<Window x:Class="SysDiag.DeltaCacheWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏优化" Height="830" Width="940" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="CacheTemplate">
            <Border Padding="12,9" Margin="0,0,0,6" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource InkSecondary}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShaderTemplate">
            <Border Padding="12,9" Margin="0,0,0,6" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <Border Background="{StaticResource PrimarySoft}" CornerRadius="7" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Vendor}" FontSize="10" Foreground="{StaticResource Primary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource InkSecondary}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="{StaticResource InkFaint}"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="游戏优化" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <!-- 游戏路径 -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Margin="24,0,24,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ExeText" FontSize="11.5" Foreground="{StaticResource InkSecondary}"
                               TextTrimming="CharacterEllipsis" Text="正在定位游戏主程序…" />
                    <TextBlock x:Name="GameRootText" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择游戏 exe" Style="{StaticResource ToolButton}" Click="OnPickExe" />
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Click="OnRescan" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2" Margin="24,12,24,0" Background="Transparent" BorderThickness="0"
                    SelectionChanged="OnTabChanged"
                    Padding="0">

            <!-- ============ 缓存 ============ -->
            <TabItem Header="缓存清理">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- 游戏缓存 -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <TextBlock Text="游戏缓存" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="7" Padding="7,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="GameCacheSize" Text="0 MB" FontSize="10" Foreground="{StaticResource Accent}" />
                                </Border>
                                <Button x:Name="ToggleBtn" Content="全选" Style="{StaticResource ToolButton}" Margin="14,0,0,0"
                                        Click="OnToggleAll" />
                            </StackPanel>

                            <TextBlock x:Name="GameCacheEmpty" FontSize="11" Foreground="{StaticResource InkTertiary}"
                                       Margin="2,0,0,6" TextWrapping="Wrap"
                                       Text="正在扫描 Saved 目录…" />

                            <ItemsControl x:Name="CacheList" ItemTemplate="{StaticResource CacheTemplate}" />

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,14" />

                            <!-- 着色器缓存 -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <TextBlock Text="着色器缓存" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource PrimarySoft}" CornerRadius="7" Padding="7,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ShaderCacheSize" Text="0 MB" FontSize="10" Foreground="{StaticResource Primary}" />
                                </Border>
                                <Button Content="全部勾选" Style="{StaticResource ToolButton}" Margin="14,0,0,0"
                                        Click="OnSelectAllShader" />
                                <Button Content="清理选中" Style="{StaticResource ToolButton}"
                                        Click="OnClearShader" />
                            </StackPanel>

                            <TextBlock FontSize="10.5" Foreground="{StaticResource InkTertiary}" Margin="2,0,0,6" TextWrapping="Wrap"
                                       Text="驱动或游戏更新后着色器会失效重建；首次进地图会重新编译、期间可能掉帧，属正常现象。" />

                            <TextBlock x:Name="ShaderCacheEmpty" FontSize="11" Foreground="{StaticResource InkTertiary}"
                                       Margin="2,0,0,6" TextWrapping="Wrap" Text="正在扫描…" />

                            <ItemsControl x:Name="ShaderList" ItemTemplate="{StaticResource ShaderTemplate}" />

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,14" />

                            <!-- VC++ 运行库 -->
                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="VC++ 2015–2022 运行库" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        <Border x:Name="VcBadge" Background="{StaticResource SurfaceRaise}" CornerRadius="7" Padding="7,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="VcBadgeText" Text="未检查" FontSize="10"
                                                       Foreground="{StaticResource InkTertiary}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="VcDetail" FontSize="10.5" Foreground="{StaticResource InkTertiary}"
                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                               Text="只读检查系统组件，不会自动下载或安装。" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="检查运行库" Style="{StaticResource ToolButton}"
                                        VerticalAlignment="Center" Click="OnCheckVc" />
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="清理游戏缓存" Style="{StaticResource PrimaryButton}" Click="OnDelete" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 图形设置 ============ -->
            <TabItem Header="图形设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,10,0,0">
                    <StackPanel>

                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="高性能 GPU" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        <Border x:Name="GpuBadge" Background="{StaticResource SurfaceRaise}" CornerRadius="7" Padding="7,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="GpuBadgeText" Text="未设置" FontSize="10"
                                                       Foreground="{StaticResource InkTertiary}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="10.5" Foreground="{StaticResource InkTertiary}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="指定 Windows 为该游戏优先使用高性能显卡。等同于「设置 → 显示 → 图形」里给程序选「高性能」。" />
                                    <TextBlock x:Name="GpuRaw" FontSize="10" Foreground="{StaticResource InkFaint}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button x:Name="GpuBtn" Grid.Column="1" Content="设为高性能"
                                        Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                                        Click="OnToggleGpu" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="禁用全屏优化" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        <Border x:Name="FsBadge" Background="{StaticResource SurfaceRaise}" CornerRadius="7" Padding="7,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="FsBadgeText" Text="未勾选" FontSize="10"
                                                       Foreground="{StaticResource InkTertiary}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="10.5" Foreground="{StaticResource InkTertiary}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="映射到程序属性的兼容性选项，只影响这一个程序，不覆盖其他兼容性设置（RUNASADMIN、高 DPI 等标记会保留）。" />
                                    <TextBlock x:Name="CompatRaw" FontSize="10" Foreground="{StaticResource InkFaint}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button x:Name="FsBtn" Grid.Column="1" Content="禁用全屏优化"
                                        Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                                        Click="OnToggleFullscreen" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10"
                                Padding="14,11">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource LevelHintChip}" TextWrapping="Wrap"
                                       Text="这两项都写在 HKCU，只对当前用户和这一个 exe 生效，不需要管理员。改完要完全退出游戏再启动才生效；如果游戏有独立启动器，注意选的是真正跑游戏的那个 exe。" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 全自动调优 ============ -->
            <TabItem Header="全自动调优">
                <!-- 整页一个 ScrollViewer：里面再嵌一个独立滚动的列表时，
                     ScrollViewer 会在页签切换后保留上一次的偏移，
                     表现出来就是「打开就停在第 6 项」，怎么重置都容易被布局改回去。 -->
                <ScrollViewer x:Name="StepScroll" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,8">

                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="全自动调优" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        <Border x:Name="OptBadge" Background="{StaticResource SurfaceRaise}" CornerRadius="7" Padding="7,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="OptBadgeText" Text="未优化" FontSize="10"
                                                       Foreground="{StaticResource InkTertiary}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock FontSize="10.5" Foreground="{StaticResource InkTertiary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="勾选要做的项依次执行。游戏级（GPU 首选项 / 全屏优化）只影响这个 exe；标了「系统级」的会影响整台机器，各自备份原值后可整批回滚。" />

                                    <TextBlock x:Name="BackupTimeText" FontSize="10.5" Foreground="{StaticResource Warn}"
                                               Margin="0,5,0,0" Text="还没有备份" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="全选" Style="{StaticResource ToolButton}" Click="OnStepSelectAll" />
                                    <Button Content="只选安全项" Style="{StaticResource ToolButton}" Click="OnStepSelectSafe" />
                                    <Button Content="手动备份" Style="{StaticResource ToolButton}" Click="OnManualBackup" />
                                    <Button Content="一键回滚" Style="{StaticResource ToolButton}" Click="OnRollback" />
                                    <Button x:Name="OptBtn" Content="开始调优" Style="{StaticResource PrimaryButton}"
                                            Click="OnRunAutoTune" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="16,2,16,6" Margin="0,0,0,10">
                            <StackPanel x:Name="StepHost" Margin="0,4,4,4" />
                        </Border>

                        <Border x:Name="LogCard" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource LevelOk}" VerticalAlignment="Center" />
                                    <TextBlock Text="实时日志" FontSize="11" Foreground="{StaticResource InkSecondary}" Margin="7,0,0,0" />
                                    <Button Content="清空" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                                            Padding="8,0" Height="24" Click="OnClearLog" />
                                </StackPanel>

                                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Height="150"
                                         Background="{StaticResource SurfaceRaise}" Foreground="{StaticResource InkSecondary}" FontFamily="Consolas"
                                         FontSize="11.5" Padding="10,8" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="勾选要做的项，点「开始调优」…" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left" />
                <Button Content="关闭" Style="{StaticResource ToolButton}" HorizontalAlignment="Right"
                        Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
