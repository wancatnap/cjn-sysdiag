<Window x:Class="SysDiag.SigmaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDiag.Controls"
        Title="日志规则匹配" Height="860" Width="1040" MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="日志规则匹配" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource PageBadge}">
                    <TextBlock x:Name="RuleBadge" Text="Sigma 子集" FontSize="9.5" Foreground="{StaticResource Primary}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 摘要 -->
        <Border Grid.Row="1" Margin="24,0,24,0" Padding="16,13" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock x:Name="HitCount" Text="—" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="命中" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock x:Name="HighCount" Text="0" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource Danger}" />
                        <TextBlock Text="高 / 严重" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock x:Name="MediumCount" Text="0" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource LevelHint}" />
                        <TextBlock Text="中" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ScanText" Text="—" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource Primary}" />
                        <TextBlock Text="事件数" FontSize="9.5" Foreground="{StaticResource InkFaint}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="VerdictText" Text="正在读取事件日志…" FontSize="11.5"
                           Foreground="{StaticResource InkSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </Grid>
        </Border>

        <!-- 工具条 -->
        <Grid Grid.Row="2" Margin="24,12,24,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RescanBtn" Content="重新匹配" Style="{StaticResource ToolButton}" Margin="0" Click="OnRescan" />
                <Button x:Name="ReportBtn" Content="生成报告" Style="{StaticResource ToolButton}"
                        IsEnabled="False" Click="OnReport" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ScanHint" Text="准备开始…" FontSize="11" Foreground="{StaticResource InkTertiary}"
                           VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource ToolButton}"
                        Click="OnElevate" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- 命中列表（统一表格） -->
        <controls:LogGridView x:Name="HitGrid" Grid.Row="3" Margin="24,4,24,0" />

        <!-- 底部：通道状态 -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,10" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="ChannelList" Grid.Column="0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceRaise}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,2,6,2"
                                    ToolTip="{Binding Note}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="{StaticResource InkSecondary}"
                                               Margin="5,0,0,0" />
                                    <TextBlock Text="{Binding Count}" FontSize="9" FontFamily="Consolas"
                                               Foreground="{StaticResource InkFaint}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ElapsedText" Text="" FontSize="10" Foreground="{StaticResource InkFaint}"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="关闭" Style="{StaticResource ToolButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
